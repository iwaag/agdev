from urllib.parse import urlsplit

SCHEMAS = {"agdev.publication.v1", "forge.publication.v1"}
JOURNAL_SCHEMA = "agdev.publication.v1.journal"
HOLDS_SCHEMA = "agdev.publication.v1.holds"
DEFAULT_CONTRACT = "publication/github.toml"
OVERLAY = "publication/overlay"


class Refusal(SystemExit):
    """A stop with a category (`code`) a workflow can act on: conflict, stale-public-head, unavailable-source,
    child-not-public, graph, contract, check-failed, checkout-state, owner, busy, infrastructure, usage, rule, scope, hold."""
    code = "refused"

    @classmethod
    def coded(cls, code: str, message: str) -> "Refusal":
        refusal = cls(message)
        refusal.code = code
        return refusal


# ---------------------------------------------------------------- operation ownership

UNFINISHED = ("staging", "staged", "partial", "conflict")


def last_stage(journal: dict) -> dict | None:
    ops = [o for o in journal.get("operations", []) if o.get("command") == "stage"]
    return ops[-1] if ops else None


def check_owner(journal: dict, owner: str | None, action: str, take_over: str | None = None) -> None:
    """A staging with an owner can be pushed, resolved or aborted only by that owner (a workflow run). Stagings
    made without one (by hand, before owners existed) stay operable without one."""
    op = last_stage(journal)
    held = op.get("owner") if op else None
    if held and owner != held and take_over:
        op.setdefault("notes", []).append(f"{now()}: {action} by {owner or 'no owner'} taking over from {held}: {take_over}")
        return
    if held and owner != held:
        raise Refusal.coded("owner", f"the last staging ({op['id']}, {op['status']}) belongs to {held}; {action} with "
                            f"--owner {held}, or stage again with --take-over <reason> once that owner has finished")


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def git(cwd: Path, *args: str, data: bytes | None = None, env: dict | None = None, check: bool = True) -> bytes:
    result = subprocess.run(["git", "-C", str(cwd), *args], input=data, capture_output=True,
                            env={**os.environ, **(env or {})})
    if check and result.returncode != 0:
        raise Refusal.coded("infrastructure", f"git {' '.join(args)}: {result.stderr.decode(errors='replace').strip()}")
    return result.stdout


def git_ok(cwd: Path, *args: str) -> bool:
    return subprocess.run(["git", "-C", str(cwd), *args], capture_output=True).returncode == 0


# ---------------------------------------------------------------- identity

def identity(url: str) -> str:
    """Repository identity from an internal URL: its path without '.git' (host-independent)."""
    path = urlsplit(url).path if "://" in url else url.split(":", 1)[-1]
    path = path.strip("/")
    return path[:-4] if path.endswith(".git") else path


def resolve_url(base: str, rel: str) -> str:
    """Git's relative submodule URL: relative to the superproject's remote URL."""
    if not (rel.startswith("./") or rel.startswith("../")):
        return rel
    base = base.rstrip("/")
    while True:
        if rel.startswith("./"):
            rel = rel[2:]
        elif rel.startswith("../"):
            rel = rel[3:]
            base = base.rsplit("/", 1)[0]
        else:
            break
    return f"{base}/{rel}"


# ---------------------------------------------------------------- context, journal, lock

class Ctx:
    def __init__(self, workspace: Path | None, source: Path | None, contract: str):
        self.source = (source or (workspace / "source" if workspace else Path.cwd())).resolve()
        top = git(self.source, "rev-parse", "--show-toplevel", check=False).decode().strip()
        if not top:
            raise Refusal.coded("usage", f"{self.source} is not a Git checkout")
        self.source = Path(top)
        self.workspace = (workspace or self.source.parent).resolve()
        self.contract = contract
        self.state = self.workspace / ".agdev" / "publication"
        self.journal_path = self.state / "github.json"

    def read_journal(self) -> dict:
        if not self.journal_path.is_file():
            return {"schema": JOURNAL_SCHEMA, "repositories": {}, "operations": []}
        data = json.loads(self.journal_path.read_text(encoding="utf-8"))
        if data.get("schema") != JOURNAL_SCHEMA:
            raise Refusal.coded("usage", f"{self.journal_path} is {data.get('schema')}: run convert-journal first")
        return data

    def write_journal(self, data: dict) -> None:
        self.state.mkdir(parents=True, exist_ok=True)
        tmp = self.journal_path.with_name(self.journal_path.name + ".tmp")
        tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        tmp.replace(self.journal_path)

    @contextmanager
    def lock(self, wait: float = 0):
        """The workspace's publication lock; `wait` seconds to wait for a running operation (a hold waits: a push is short)."""
        import time
        self.state.mkdir(parents=True, exist_ok=True)
        with open(self.state / ".lock", "w") as handle:
            until = time.monotonic() + wait
            while True:
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= until:
                        raise Refusal.coded("busy", f"another publication operation holds {self.state / '.lock'}")
                    time.sleep(0.5)
            yield

    @property
    def holds_path(self) -> Path:
        return self.state / "holds.json"

    def read_holds(self) -> list[dict]:
        if not self.holds_path.is_file():
            return []
        data = json.loads(self.holds_path.read_text(encoding="utf-8"))
        return list(data.get("holds", []))

    def write_holds(self, holds: list[dict]) -> None:
        self.state.mkdir(parents=True, exist_ok=True)
        tmp = self.holds_path.with_name(self.holds_path.name + ".tmp")
        tmp.write_text(json.dumps({"schema": HOLDS_SCHEMA, "holds": holds}, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        tmp.replace(self.holds_path)


# ---------------------------------------------------------------- graph

class Node:
    def __init__(self, repo: Path, rev: str, url: str, contract_path: str, path: str | None):
        self.repo, self.rev, self.url, self.contract_path, self.path = repo, rev, url, contract_path, path
        self.id = identity(url)
        self.name = self.id.rsplit("/", 1)[-1]
        self.contract: dict = {}
        self.children: list[Node] = []
        self.excluded: list[dict] = []


def load_contract(repo: Path, rev: str, path: str) -> dict:
    raw = git(repo, "cat-file", "blob", f"{rev}:{path}", check=False)
    if not raw:
        raise Refusal.coded("contract", f"{identity_of(repo)}@{rev[:12]} has no contract {path}")
    contract = tomllib.loads(raw.decode())
    if contract.get("schema") not in SCHEMAS:
        raise Refusal.coded("contract", f"{path} at {rev[:12]} is not one of {sorted(SCHEMAS)}")
    return contract


def identity_of(repo: Path) -> str:
    url = git(repo, "remote", "get-url", "origin", check=False).decode().strip()
    return identity(url) if url else str(repo)


def gitlinks_at(repo: Path, rev: str) -> dict[str, str]:
    links = {}
    for line in git(repo, "ls-tree", "-r", rev).decode().splitlines():
        meta, path = line.split("\t", 1)
        mode, kind, sha = meta.split()
        if mode == "160000":
            links[path] = sha
    return links


def gitmodules_at(repo: Path, rev: str) -> dict[str, str]:
    if not git_ok(repo, "cat-file", "-e", f"{rev}:.gitmodules"):
        return {}
    entries: dict[str, dict] = {}
    for line in git(repo, "config", "--blob", f"{rev}:.gitmodules", "--list").decode().splitlines():
        key, _, value = line.partition("=")
        if not key.startswith("submodule."):
            continue
        name, _, attr = key[len("submodule."):].rpartition(".")
        entries.setdefault(name, {})[attr] = value
    return {e["path"]: e.get("url", "") for e in entries.values() if "path" in e}


def discover(ctx: Ctx, rev: str) -> Node:
    root_rev = git(ctx.source, "rev-parse", "--verify", f"{rev}^{{commit}}").decode().strip()
    url = git(ctx.source, "remote", "get-url", "origin").decode().strip()
    return traverse(Node(ctx.source, root_rev, url, ctx.contract, None), [])


def traverse(node: Node, stack: list[str]) -> Node:
    if node.id in stack:
        raise Refusal.coded("graph", "submodule cycle: " + " -> ".join(stack + [node.id]))
    node.contract = load_contract(node.repo, node.rev, node.contract_path)
    links, modules = gitlinks_at(node.repo, node.rev), gitmodules_at(node.repo, node.rev)
    declared = {s["path"]: s for s in node.contract.get("submodule", [])}
    excluded = {e["path"]: e for e in node.contract.get("exclude", [])}
    for path in links:
        if path in excluded:
            node.excluded.append({"path": path, "why": excluded[path].get("why", ""), "source_rev": links[path]})
        elif path not in declared:
            raise Refusal.coded("graph", f"{node.id}@{node.rev[:12]}: submodule {path} is neither declared ([[submodule]]) nor "
                          "excluded ([[exclude]] with a reason): a required private dependency is never dropped silently")
    for path, spec in declared.items():
        if path not in links:
            raise Refusal.coded("graph", f"{node.id}@{node.rev[:12]}: [[submodule]] {path} is not a submodule at that revision")
        if path not in modules or not modules[path]:
            raise Refusal.coded("graph", f"{node.id}@{node.rev[:12]}: .gitmodules has no URL for {path}")
        child_repo = node.repo / path
        if not (child_repo / ".git").exists():
            raise Refusal.coded("unavailable-source", f"no local repository for {node.id}:{path} at {child_repo} (git submodule update --init)")
        sha = links[path]
        if not git_ok(child_repo, "cat-file", "-e", f"{sha}^{{commit}}"):
            git(child_repo, "fetch", "-q", "origin", check=False)
            if not git_ok(child_repo, "cat-file", "-e", f"{sha}^{{commit}}"):
                raise Refusal.coded("unavailable-source", f"{node.id}@{node.rev[:12]} pins {path} at {sha[:12]}, which is not available "
                              f"in {child_repo} or its origin")
        child = Node(child_repo, sha, resolve_url(node.url, modules[path]), spec.get("contract", DEFAULT_CONTRACT), path)
        node.children.append(traverse(child, stack + [node.id]))
    return node


def postorder(root: Node) -> list[Node]:
    """Dependencies before dependents; one node per repository (same revision deduplicated)."""
    order: list[Node] = []
    seen: dict[str, Node] = {}

    def visit(node: Node):
        for child in node.children:
            visit(child)
        if node.id in seen:
            if seen[node.id].rev != node.rev:
                raise Refusal.coded("graph", f"unsupported: {node.id} is needed at {seen[node.id].rev[:12]} and {node.rev[:12]} in one "
                              "graph; publish one revision first, or align the pins")
            return
        seen[node.id] = node
        order.append(node)

    visit(root)
    return order


def validate(ctx: Ctx, root: Node, journal: dict) -> list[str]:
    problems = []
    order = postorder(root)
    by_destination: dict[str, str] = {}
    for node in order:
        dest = node.contract["destination"]
        if dest in by_destination and by_destination[dest] != node.id:
            problems.append(f"{node.id} and {by_destination[dest]} both publish to {dest}")
        by_destination[dest] = node.id
        known = journal["repositories"].get(node.id)
        if known and known["destination"] != dest:
            problems.append(f"{node.id} was published to {known['destination']}; its contract now says {dest} "
                            "(a destination change is a new decision: edit the journal deliberately)")
        publics = {f["public"] for f in node.contract.get("file", [])}
        for child in node.children:
            for public in publics:
                if public == child.path or public.startswith(child.path + "/") or child.path.startswith(public + "/"):
                    problems.append(f"{node.id}: public file {public} collides with submodule path {child.path}")
        if node.children and any(f["public"] == ".gitmodules" for f in node.contract.get("file", [])):
            problems.append(f"{node.id}: .gitmodules is generated from [[submodule]]; do not select it as a file")
    return problems


def checkout_of(ctx: Ctx, root: Node, node: Node, journal: dict) -> Path:
    known = journal["repositories"].get(node.id, {}).get("checkout")
    if known:
        return ctx.workspace / known
    return ctx.workspace / ("published" if not root.children else f"published/{node.name}")


# ---------------------------------------------------------------- build and check

def blob(repo: Path, rev: str, path: str) -> tuple[bytes, str]:
    listing = git(repo, "ls-tree", rev, "--", path).decode().split()
    if not listing:
        raise Refusal.coded("contract", f"{path} is not tracked at {rev[:12]}")
    return git(repo, "cat-file", "blob", f"{rev}:{path}"), listing[0]


def excluded_by(rel: str, patterns: list[str]) -> bool:
    """A glob excludes a path it matches, or every path below a directory it matches (`*` crosses '/')."""
    return any(fnmatch(rel, p) or fnmatch(rel, p.rstrip("/") + "/*") for p in patterns)


def tree_selection(repo: Path, rev: str, contract: dict, locals_: list[str] | None = None) -> dict[str, tuple[bytes, str, str, str | None]]:
    """Every file a [[tree]] selects: public path -> (content, mode, origin, source path or None). A tree copies a directory of the
    source (or overlay) at the pinned revision, minus `exclude` globs (relative to `from`). Gitlinks and
    .gitmodules are never copied (submodules come from [[submodule]]), nor the source's publication/ folder, nor
    anything below devdocs/runs/ (a run record is selected by its own [[run]]) or at or below a [[local]] path."""
    selected: dict[str, tuple[bytes, str, str, str | None]] = {}
    for spec in contract.get("tree", []):
        kind, _, base = spec.get("from", "").partition(":")
        if kind not in ("source", "overlay"):
            raise Refusal.coded("contract", f"[[tree]] from {spec.get('from')!r}: source:<dir> or overlay:<dir>")
        base = base.strip("/")
        root = f"{OVERLAY}/{base}".rstrip("/") if kind == "overlay" else base
        public_root = spec.get("public", "").strip("/").removeprefix(".").strip("/")
        excludes = list(spec.get("exclude", []))
        listing = git(repo, "ls-tree", "-r", "-z", "--full-tree", rev, *(["--", root] if root else [])).decode()
        found = 0
        for record in filter(None, listing.split("\0")):
            meta, path = record.split("\t", 1)
            mode, kind_, sha = meta.split()
            if kind_ != "blob" or mode == "120000":
                continue  # gitlinks are [[submodule]]s; symbolic links are not published
            rel = path[len(root) + 1:] if root else path
            if kind == "source" and (path == ".gitmodules" or path == OVERLAY.split("/")[0] or
                                     path.startswith(OVERLAY.split("/")[0] + "/")):
                continue
            if excluded_by(rel, excludes):
                continue
            if kind == "source" and (under(path, RUNS_DIR) or any(under(path, l) for l in locals_ or [])):
                continue  # improve_publish p2: run records only by [[run]]; a [[local]] path is left out
            public = f"{public_root}/{rel}" if public_root else rel
            if public in selected:
                raise Refusal.coded("contract", f"{public} is selected by two [[tree]] entries")
            selected[public] = (git(repo, "cat-file", "blob", sha), mode, f"{spec['from']} (tree)",
                                path if kind == "source" else None)
            found += 1
        if not found:
            raise Refusal.coded("contract", f"[[tree]] {spec.get('from')} selects nothing at {rev[:12]}")
    return selected


def admitted(ctx: Ctx, rel: str, digest: str) -> bytes:
    """A workspace input with the pinned hash: the live file, or the kept copy."""
    store = ctx.state / "inputs" / digest
    live = ctx.workspace / rel
    if live.is_file():
        content = live.read_bytes()
        if hashlib.sha256(content).hexdigest() == digest:
            store.parent.mkdir(parents=True, exist_ok=True)
            if not store.exists():
                store.write_bytes(content)
            return content
    if store.is_file():
        return store.read_bytes()
    raise Refusal.coded("contract", f"workspace:{rel} does not have sha256 {digest} (and no kept copy): review it and pin its hash")


RULES_FILE, RULES_SCHEMAS = "rules.yaml", ("ag.catalog-rules.v1", "ag.catalog-rules.v2")
EPISODES = "braindumps/episodes/"


def installation_area() -> Path | None:
    """The WFE area of the installation this tool belongs to: $WFE_AREA, the folder of $WFE_REGISTRY, or
    <root>/data/area for the installed tool (<root>/config/install/agdev-external-publish)."""
    if os.environ.get("WFE_AREA"):
        return Path(os.environ["WFE_AREA"])
    if os.environ.get("WFE_REGISTRY"):
        return Path(os.environ["WFE_REGISTRY"]).parent
    guess = Path(__file__).resolve().parents[2] / "data" / "area"
    return guess if guess.is_dir() else None


def import_yaml():
    """PyYAML, also from the user site of the account's own home when HOME points elsewhere (agent sessions do:
    improve_publish p2 report 1). None when this interpreter has none."""
    try:
        import yaml
        return yaml
    except ImportError:
        pass
    import pwd
    home, ver = Path(pwd.getpwuid(os.getuid()).pw_dir), f"{sys.version_info.major}.{sys.version_info.minor}"
    for site in (home / "Library" / "Python" / ver / "lib" / "python" / "site-packages",
                 home / ".local" / "lib" / f"python{ver}" / "site-packages"):
        if site.is_dir() and str(site) not in sys.path:
            sys.path.append(str(site))
    try:
        import yaml
        return yaml
    except ImportError:
        return None


def read_yaml_rules(raw: bytes, where: str) -> dict:
    yaml = import_yaml()
    if yaml is None:
        raise Refusal.coded("rule", f"{where} holds adopted rules and PyYAML is not installed to read them: "
                                    "nothing is built (python3 -m pip install pyyaml)")
    class Loader(yaml.SafeLoader):  # times stay as written (a public form copies them as they are)
        pass
    Loader.yaml_implicit_resolvers = {k: [r for r in v if r[0] != "tag:yaml.org,2002:timestamp"]
                                      for k, v in yaml.SafeLoader.yaml_implicit_resolvers.items()}
    try:
        return yaml.load(raw.decode("utf-8"), Loader=Loader) or {}
    except Exception as error:  # a rules file that cannot be read protects nothing: refuse
        raise Refusal.coded("rule", f"{where} cannot be read ({error}): nothing is built")


_CATALOG: tuple[list[dict], dict] | None = None


def catalog_state() -> tuple[list[dict], dict]:
    """The rules of this installation's catalog (rules.yaml at HEAD of the service's clone) and its open link
    suggestion (<area>/.local/catalog-links.json, with the summoner's proposals). ([], {}) without a catalog."""
    global _CATALOG
    if _CATALOG is not None:
        return _CATALOG
    rules: list[dict] = []
    links: dict = {}
    area = installation_area()
    if area and (area / "catalog.json").is_file():
        clone = area / ".local" / "catalog"
        raw = git(clone, "cat-file", "blob", f"HEAD:{RULES_FILE}", check=False) if clone.is_dir() else b""
        if raw and any(schema in raw.decode("utf-8", errors="replace") for schema in RULES_SCHEMAS):
            rules = [r for r in read_yaml_rules(raw, f"the catalog's {RULES_FILE}").get("rules") or [] if isinstance(r, dict)]
        try:
            links = json.loads((area / ".local" / "catalog-links.json").read_text(encoding="utf-8")) or {}
        except Exception:
            links = {}
    _CATALOG = (rules, links)
    return _CATALOG


def has_catalog() -> bool:
    area = installation_area()
    return bool(area and (area / "catalog.json").is_file())


_PRIVATE: dict | None = None


def private_projects() -> dict[str, list[str]]:
    """The projects this installation's catalog keeps private, each with why (the same reading as
    `wfe catalog disclosure`: an adopted project rule never-publish at HEAD of the service's clone, or such a
    proposal not declined). {} on an installation without a catalog. A content rule for one project
    (improve_publish p2) is not a project rule."""
    global _PRIVATE
    if _PRIVATE is not None:
        return _PRIVATE
    found: dict[str, list[str]] = {}
    rules, links = catalog_state()
    for r in rules:
        if r.get("project") and not r.get("content") and r.get("follows") == "never-publish":
            src = r.get("source") or {}
            found.setdefault(str(r["project"]), []).append(
                f"rule {r.get('id')}, adopted by {(r.get('adopted') or {}).get('by')} from "
                f"{src.get('braindump')}@{str(src.get('commit'))[:7]}: \"{src.get('sentence')}\"")
    for d in links.get("disclosure") or []:
        if d.get("project") and not d.get("content") and d.get("follows") == "never-publish" and d.get("state") == "suggested":
            found.setdefault(str(d["project"]), []).append(
                f"proposed by {links.get('by')} ({links.get('id')}, {d.get('n')}) from {d.get('braindump')}: "
                f"\"{d.get('quote')}\" (not answered yet; No on the Catalog page lifts it)")
    _PRIVATE = found
    return found


# ---------------------------------------------------------------- content rules (improve_publish p2)

RUNS_DIR, EPISODES_SRC, WORKFLOWS_DIR = "devdocs/runs", "devdocs/episodes", "devdocs/workflows"
CONTENTS = ("runs", "workflows", "episodes")
RUN_FILES = ["request.md", "report.md"]
RUN_NEVER = ("run.json", "original-input.md")
RUN_NEVER_DIRS = ("context", "definition")
# improve_publish p2 decision 12: since every contract has its grounds (step 6), a missing `because` is a contract
# refusal for build and stage.
GROUNDS_REQUIRED = True


def under(path: str, base: str) -> bool:
    base = base.strip("/")
    return path == base or path.startswith(base + "/")


def content_statements(content: str) -> list[dict]:
    """Every statement on a kind of content: adopted rules, and the summoner's proposals not answered."""
    rules, links = catalog_state()
    out = []
    for r in rules:
        if r.get("content") == content:
            src = r.get("source") or {}
            out.append({"rule": r.get("id"), "project": r.get("project") or None, "follows": r.get("follows"),
                        "adopted": True, "at": str((r.get("adopted") or {}).get("at") or ""),
                        "braindump": src.get("braindump"), "sentence": src.get("sentence")})
    for d in links.get("disclosure") or []:
        if d.get("content") == content and d.get("state") == "suggested":
            out.append({"proposal": f"{links.get('id')} #{d.get('n')}", "project": d.get("project") or None,
                        "follows": d.get("follows"), "adopted": False, "by": links.get("by"),
                        "braindump": d.get("braindump"), "sentence": d.get("quote")})
    return out


def criterion(content: str, project: str | None) -> dict | None:
    """The statement that decides a kind of content of a project: of the statements in force (adopted, or a
    proposed never-publish), those for this project, else the general ones; never-publish wins between them. A
    proposed suggest-publish decides nothing until the owner's OK."""
    force = [x for x in content_statements(content) if x["adopted"] or x["follows"] == "never-publish"]
    own = [x for x in force if project and x["project"] == project]
    pool = own or [x for x in force if not x["project"]]
    return next((x for x in pool if x["follows"] == "never-publish"), None) or next(
        (x for x in pool if x["follows"] == "suggest-publish"), None)


def statement_words(x: dict) -> str:
    who = f"rule {x['rule']}" if x.get("rule") else f"proposed by {x.get('by')} ({x.get('proposal')}, not answered yet)"
    return f"{who}, from {x.get('braindump')}: \"{x.get('sentence')}\""


def content_refusal(content: str, project: str | None, what: str) -> None:
    """A selection of run records, episodes or workflows against the owner's words: never-publish refuses; run
    records and episodes without a suggest-publish stay local (p1 principle 2)."""
    c = criterion(content, project)
    if c and c["follows"] == "never-publish":
        raise Refusal.coded("rule", f"{what}: {content} of {project or 'any project'} are never published ({statement_words(c)})")
    if content in ("runs", "episodes") and not c:
        raise Refusal.coded("rule", f"{what}: no rule of the owner states that {content} of {project or 'this project'} "
                                    f"are published, so they stay local (agdev docs/external-publication.md, What stays local)")


def project_of(ctx: "Ctx") -> str | None:
    """The project a workspace belongs to (the registry, else pj-<id>); None for the catalog's own workspace."""
    area = installation_area()
    if area and (area / "catalog.json").is_file():
        try:
            setting = json.loads((area / "catalog.json").read_text(encoding="utf-8"))
            if setting.get("publicationWorkspace") and Path(setting["publicationWorkspace"]).resolve() == ctx.workspace:
                return None
        except Exception:
            pass
    project = None
    if area:
        try:
            registry = json.loads((area / "registry.json").read_text(encoding="utf-8"))
            for w in registry.get("workspaces", []):
                if Path(w.get("path", "")).resolve() == ctx.workspace:
                    project = w.get("project") or w.get("id")
        except Exception:
            pass
    if not project and ctx.workspace.name.startswith("pj-"):
        project = ctx.workspace.name[3:]
    return project


def private_name_re(project: str):
    import re
    return re.compile(r"(?<![A-Za-z0-9])" + re.escape(project) + r"(?![A-Za-z0-9])", re.IGNORECASE)


def disclosure_refusal(ctx: "Ctx") -> None:
    """A project the owner's words keep private (user_catalog p8; agdev docs/mycatalog.md, Rules): an adopted
    `project: <id>, follows: never-publish` in the catalog's rules.yaml, or such a statement the summoner proposed
    and the owner has not declined (<area>/.local/catalog-links.json). Its workspace is refused for build, stage and
    push. An installation without a catalog, or a catalog without such a rule, is not affected."""
    if not has_catalog():
        return
    project = project_of(ctx)
    if not project:
        return  # the catalog itself (its tag rules are read from the candidate), or no project known
    found = private_projects().get(project, [])
    if found:
        raise Refusal.coded("rule", f"project {project} is kept private by the owner's words: {'; '.join(found)}. "
                                    "Nothing of it is published by this tool (wfe catalog disclosure)")


def selected_sources(repo: Path, rev: str, contract: dict) -> tuple[list[str], set[str]]:
    """Every path of the repository at rev, and the source paths the contract selects ([[file]] source: and
    [[tree]] source: minus its excludes)."""
    selected = {e["from"].partition(":")[2].strip("/") for e in contract.get("file", [])
                if e.get("from", "").startswith("source:")}
    listing = [r.split("\t", 1)[1] for r in
               filter(None, git(repo, "ls-tree", "-r", "-z", "--full-tree", rev).decode().split("\0"))]
    for spec in contract.get("tree", []):
        kind, _, base = spec.get("from", "").partition(":")
        if kind != "source":
            continue
        base = base.strip("/")
        for path in listing:
            if base and not path.startswith(base + "/"):
                continue
            if not excluded_by(path[len(base) + 1:] if base else path, list(spec.get("exclude", []))):
                selected.add(path)
    return listing, selected


def public_rules(repo: Path, rev: str, contract: dict, raw: bytes) -> bytes:
    """The public form of a catalog's rules.yaml (improve_publish p1 decisions 4-7): the rules whose source
    braindump this candidate selects, that are not never-publish on a project (it names what is private) and not
    share: never; without source.commit (an internal commit no reader can resolve); adopted.by the account of the
    destination (only the owner adopts a rule). Everything else is left out without a trace."""
    yaml = import_yaml()
    doc = read_yaml_rules(raw, f"{RULES_FILE} at {rev[:12]}")
    _, selected = selected_sources(repo, rev, contract)
    account = identity(contract.get("destination", "")).split("/")[0] or None
    kept = []
    for r in doc.get("rules") or []:
        if not isinstance(r, dict):
            continue
        source = r.get("source") or {}
        if f"{EPISODES}{source.get('braindump')}/braindump.md" not in selected:
            continue
        if r.get("project") and not r.get("content") and r.get("follows") == "never-publish":
            continue
        if r.get("content") and r.get("project") and str(r["project"]) in private_projects():
            continue  # a content rule naming a project kept private names what is private
        if r.get("share") == "never" or r.get("follows") == "default-licence":
            continue
        rule = {k: r[k] for k in ("id", "content", "tag", "project", "follows") if k in r}
        rule["source"] = {k: source[k] for k in ("braindump", "sentence") if k in source}
        adopted = dict(r.get("adopted") or {})
        if account and "by" in adopted:
            adopted["by"] = account
        if adopted:
            rule["adopted"] = adopted
        kept.append(rule)
    head = ("# Rules adopted by the owner from their own words (ag.catalog-rules.v2; agdev docs/mycatalog.md, "
            "Rules).\n\n")
    body = yaml.safe_dump({"schema": doc.get("schema") or "ag.catalog-rules.v2", "rules": kept},
                          allow_unicode=True, sort_keys=False, width=1000)
    return (head + body).encode("utf-8")


def is_catalog(repo: Path, rev: str) -> bool:
    return git_ok(repo, "cat-file", "-e", f"{rev}:mycatalog.yaml")


def rule_refusals(repo: Path, rev: str, contract: dict) -> None:
    """A catalog's adopted rules (rules.yaml at its root, ag.catalog-rules.v1; agdev docs/mycatalog.md, Rules).
    `never-publish` on a tag: no candidate may hold the braindump.md or review.md of a braindump whose
    metadata.yaml carries that tag at the pinned revision. A repository without that file is not affected."""
    raw = git(repo, "cat-file", "blob", f"{rev}:{RULES_FILE}", check=False)
    if not raw or not any(schema in raw.decode("utf-8", errors="replace") for schema in RULES_SCHEMAS):
        return
    doc = read_yaml_rules(raw, f"{RULES_FILE} at {rev[:12]}")
    yaml = import_yaml()
    rules = [r for r in doc.get("rules") or [] if isinstance(r, dict) and r.get("follows") == "never-publish" and r.get("tag")]
    if doc.get("schema") not in RULES_SCHEMAS or not rules:
        return
    listing, selected = selected_sources(repo, rev, contract)
    for path in listing:
        if not (path.startswith(EPISODES) and path.endswith("/metadata.yaml")):
            continue
        folder = path[:-len("metadata.yaml")]
        try:
            tags = (yaml.safe_load(git(repo, "cat-file", "blob", f"{rev}:{path}").decode("utf-8")) or {}).get("tags") or []
        except Exception:
            tags = []
        tags = {str(t).lower() for t in tags}
        for rule in rules:
            if str(rule["tag"]).lower() not in tags:
                continue
            held = [f for f in (folder + "braindump.md", folder + "review.md") if f in selected]
            if held:
                source = rule.get("source") or {}
                raise Refusal.coded("rule", f"{', '.join(held)}: braindump {folder[len(EPISODES):-1]} is tagged "
                                    f"#{rule['tag']}, which is never published (rule {rule.get('id')}, adopted from "
                                    f"{source.get('braindump')}@{str(source.get('commit'))[:7]}: "
                                    f"\"{source.get('sentence')}\"). Take it out of the contract, or change the "
                                    "tag or the rule (wfe catalog publication check)")
            # user_catalog p8: a because of the public projects.yaml that names it by its path
            if "projects.yaml" in selected and (folder + "braindump.md").encode() in \
                    git(repo, "cat-file", "blob", f"{rev}:projects.yaml", check=False):
                raise Refusal.coded("rule", f"projects.yaml: a because names braindump {folder[len(EPISODES):-1]}, tagged "
                                    f"#{rule['tag']}, which is never published (rule {rule.get('id')}). Take the link "
                                    "out of the shared project, or keep projects.yaml out of the contract")


def local_paths(contract: dict) -> list[str]:
    """Source paths kept local by a decision ([[local]] path, because)."""
    out = []
    for e in contract.get("local", []):
        path = str(e.get("path", "")).strip("/")
        if not path or path.startswith(".") or ".." in path.split("/"):
            raise Refusal.coded("contract", f"[[local]] path {e.get('path')!r}: a source path")
        out.append(path)
    return out


def content_of(path: str) -> str | None:
    return "runs" if under(path, RUNS_DIR) else "episodes" if under(path, EPISODES_SRC) else \
        "workflows" if under(path, WORKFLOWS_DIR) else None


_CHECKED: dict[tuple, None] = {}


def content_check(path: str, project: str | None, what: str) -> None:
    content = content_of(path)
    if content in ("episodes", "workflows") and (content, project) not in _CHECKED:
        content_refusal(content, project, what)
        _CHECKED[(content, project)] = None


def run_files(entry: dict) -> tuple[str, list[str]]:
    run_id = str(entry.get("id", "")).strip("/")
    parts = run_id.split("/")
    if len(parts) != 2 or not all(parts) or any(x.startswith(".") for x in parts):
        raise Refusal.coded("contract", f"[[run]] id {entry.get('id')!r}: <workflow>/<run>, e.g. freework/run-018")
    names = entry.get("files", RUN_FILES)
    if not isinstance(names, list) or not names or not all(isinstance(n, str) and n for n in names):
        raise Refusal.coded("contract", f"[[run]] {run_id}: files is a list of the run folder's text files")
    for n in names:
        segs = n.strip("/").split("/")
        if n.startswith("/") or ".." in segs or segs[0] in RUN_NEVER_DIRS or n.strip("/") in RUN_NEVER:
            raise Refusal.coded("contract", f"[[run]] {run_id}: {n} is never public (run.json, original-input.md, "
                                "context/ and definition/ are kept local whatever the contract says)")
    return run_id, [n.strip("/") for n in names]


def run_selection(repo: Path, rev: str, contract: dict, project: str | None, locals_: list[str]) -> list[tuple]:
    """The files of every [[run]]: (public path, content, mode, run id). A run needs an adopted runs rule
    suggest-publish that applies to the project; never-publish (adopted or proposed) refuses."""
    out = []
    for entry in contract.get("run", []):
        run_id, names = run_files(entry)
        folder = f"{RUNS_DIR}/{run_id}"
        for l in locals_:
            if under(folder, l) or under(l, folder):
                raise Refusal.coded("contract", f"[[run]] {run_id}: {folder} is kept local ([[local]] {l})")
        content_refusal("runs", project, f"[[run]] {run_id}")
        for n in names:
            content, mode = blob(repo, rev, f"{folder}/{n}")
            try:
                content.decode("utf-8")
            except UnicodeDecodeError:
                raise Refusal.coded("contract", f"[[run]] {run_id}: {n} is not a text file; a run's media is published "
                                    "as the project's own asset, selected like any project file")
            out.append((f"{folder}/{n}", content, mode, run_id))
    return out


# ---------------------------------------------------------------- grounds and scope (improve_publish p2)

GROUND_RE = None


def ground_ok(value) -> bool:
    import re
    global GROUND_RE
    GROUND_RE = GROUND_RE or re.compile(r"^(rule:[A-Za-z0-9][A-Za-z0-9_.-]*|answer:[a-z0-9][a-z0-9_.-]*/[a-z0-9][a-z0-9_.-]*/"
                                        r"run-[0-9]+|answer:before-improve_publish|project|owner:\S.*)$")
    return isinstance(value, str) and bool(GROUND_RE.match(value))


def needs_ground(kind: str, entry: dict) -> bool:
    if kind in ("submodule", "run", "local"):
        return True
    return str(entry.get("from", "")).split(":", 1)[0] in ("source", "workspace")


def label_of(kind: str, e: dict) -> str:
    return f"[[{kind}]] " + str(e.get("id") or e.get("path") or e.get("public") or e.get("from") or "")


def grounds(contract: dict) -> dict:
    """What names no ground (or a malformed one), and the rule grounds no longer in the catalog."""
    missing, stale = [], []
    rules_known = {r.get("id") for r in catalog_state()[0]}
    pairs = [("contract", contract)] + [(k, e) for k in ("tree", "file", "submodule", "run", "local") for e in contract.get(k, [])]
    for kind, e in pairs:
        if kind != "contract" and not needs_ground(kind, e):
            continue
        where = "the contract (top-level because: the project's own ground)" if kind == "contract" else label_of(kind, e)
        value = e.get("because")
        if not ground_ok(value):
            missing.append(where + (f": because {value!r} is none of rule:<id>, answer:<project>/<workflow>/<run>, "
                                    "answer:before-improve_publish, project, owner:<name>" if value else ""))
        elif value.startswith("rule:") and has_catalog() and value[5:] not in rules_known:
            stale.append(f"{where}: {value} is not a rule of the catalog any more (reported; nothing is withdrawn)")
    return {"not_grounded": missing, "grounds_stale": stale}


def scope_items(repo: Path, rev: str, contract: dict) -> list[dict]:
    """The selections a scope is made of: source and workspace [[tree]]/[[file]], [[submodule]], [[run]]."""
    items = []
    for t in contract.get("tree", []):
        if str(t.get("from", "")).startswith("source:"):
            items.append({"kind": "tree", "public": t.get("public", ""), "from": t["from"],
                          "exclude": list(t.get("exclude", [])), "because": t.get("because")})
    for f in contract.get("file", []):
        if str(f.get("from", "")).split(":", 1)[0] in ("source", "workspace"):
            items.append({"kind": "file", "public": f["public"], "from": f["from"], "because": f.get("because")})
    for m in contract.get("submodule", []):
        items.append({"kind": "submodule", "path": m["path"], "because": m.get("because")})
    for r in contract.get("run", []):
        run_id, names = run_files(r)
        items.append({"kind": "run", "id": run_id, "files": names, "because": r.get("because")})
    return items


def item_paths(item: dict, listing: list[str], locals_: list[str]) -> list[str]:
    if item["kind"] == "file":
        kind, _, rel = item["from"].partition(":")
        return [rel.strip("/") if kind == "source" else f"workspace:{rel}"]
    if item["kind"] == "submodule":
        return [item["path"]]
    if item["kind"] == "run":
        return [f"{RUNS_DIR}/{item['id']}/{n}" for n in item["files"]]
    base = item["from"].partition(":")[2].strip("/")
    out = []
    for path in listing:
        if base and not path.startswith(base + "/"):
            continue
        if path == ".gitmodules" or under(path, "publication") or under(path, RUNS_DIR) or any(under(path, l) for l in locals_):
            continue
        if not excluded_by(path[len(base) + 1:] if base else path, item["exclude"]):
            out.append(path)
    return out


def key_of(item: dict) -> tuple:
    return (item["kind"], item.get("id") or item.get("path") or (item.get("public"), item.get("from")))


def scope_compare(repo: Path, rev: str, contract: dict, answered: list[dict]) -> tuple[list[dict], list[dict]]:
    """The current selections, each with the answer that covers it, and the scope change: the items no answered
    selection covers (new, or wider), each with the paths it adds. A path is covered when an answered [[file]]
    names it or an answered [[tree]] selects it as a pattern (new files under an answered tree are covered)."""
    listing = [r.split("\t", 1)[1] for r in filter(None, git(repo, "ls-tree", "-r", "-z", "--full-tree", rev).decode().split("\0"))]
    locals_ = local_paths(contract)
    files = {}
    trees = []
    for a in answered:
        if a["kind"] == "file":
            k, _, rel = a["from"].partition(":")
            files[rel.strip("/") if k == "source" else f"workspace:{rel}"] = a.get("answer")
        elif a["kind"] == "tree":
            trees.append(a)
    by_key = {key_of(a): a for a in answered}

    def covering(path: str) -> str | None:
        if path in files:
            return files[path] or "answered"
        for t in trees:
            base = t["from"].partition(":")[2].strip("/")
            if (not base or path.startswith(base + "/")) and not excluded_by(path[len(base) + 1:] if base else path, t.get("exclude", [])):
                return t.get("answer") or "answered"
        return None

    items, change = [], []
    for item in scope_items(repo, rev, contract):
        same = by_key.get(key_of(item))
        if item["kind"] == "run":
            adds = [n for n in item["files"] if not same or n not in same.get("files", [])]
            adds = [f"{RUNS_DIR}/{item['id']}/{n}" for n in adds]
            answer = same.get("answer") if same and not adds else None
        elif item["kind"] == "submodule":
            adds = [] if same else [item["path"]]
            answer = same.get("answer") if same else None
        else:
            paths = item_paths(item, listing, locals_)
            adds = [x for x in paths if covering(x) is None]
            answer = (same.get("answer") if same else None) or (covering(paths[0]) if paths and not adds else None)
        if adds:
            group = "run records" if item["kind"] == "run" else "workflows" if all(under(x, WORKFLOWS_DIR) for x in adds) else "the rest"
            change.append({**item, "group": group, "adds": adds})
        items.append({**item, "answer": answer if not adds else None})
    return items, change


def answered_scope(node_repo: Path, journal_state: dict | None, contract_path: str) -> tuple[list[dict], str]:
    """The last answered scope of a repository: the journal's, or (a journal from before improve_publish p2) the
    selections of the contract at the last published source revision, answered before this phase."""
    published = entries(journal_state, "published") if journal_state else []
    if not published:
        return [], "none (a first publication)"
    last = published[-1]
    if last.get("scope") is not None:
        return last["scope"], f"the journal (publication from {last['source_rev'][:12]})"
    try:
        old = load_contract(node_repo, last["source_rev"], contract_path)
        items = scope_items(node_repo, last["source_rev"], old)
    except Refusal:
        return [], "none (the last published contract cannot be read)"
    return [{**i, "answer": "answer:before-improve_publish"} for i in items], \
        f"the contract at {last['source_rev'][:12]}, published before improve_publish p2 (answer:before-improve_publish)"


def first_publication_rule(contract: dict, project: str | None) -> str | None:
    """A first publication whose contract names an adopted `project <id> publish` rule as its ground: that rule
    answers the repository itself (user_catalog p8), not its run records."""
    because = contract.get("because")
    if not (isinstance(because, str) and because.startswith("rule:")):
        return None
    for r in catalog_state()[0]:
        if r.get("id") == because[5:] and not r.get("content") and r.get("project") == project and r.get("follows") == "publish":
            return because
    return None


def scope_of(ctx: "Ctx", node: "Node", journal: dict) -> dict:
    """Everything stage and build say about one repository's scope and grounds."""
    state = journal["repositories"].get(node.id)
    answered, basis = answered_scope(node.repo, state, node.contract_path)
    items, change = scope_compare(node.repo, node.rev, node.contract, answered)
    rule = first_publication_rule(node.contract, project_of(ctx)) if not answered else None
    if rule:
        kept = []
        for c in change:
            if c["kind"] == "run":
                kept.append(c)
            else:
                for i in items:
                    if key_of(i) == key_of(c):
                        i["answer"] = rule
        change = kept
        basis += f"; the repository is answered by {rule}"
    return {"answered_by": basis, "items": items, "change": change, **grounds(node.contract),
            "local": [{"path": e.get("path"), "because": e.get("because")} for e in node.contract.get("local", [])]}


def change_lines(scope: dict) -> list[str]:
    out = []
    for group in ("run records", "workflows", "the rest"):
        items = [c for c in scope["change"] if c["group"] == group]
        if items:
            out.append(f"{group}:")
            for c in items:
                out.append(f"  {label_of(c['kind'], c)} (because {c.get('because') or 'none'}): adds {', '.join(c['adds'][:20])}"
                           + (f" and {len(c['adds']) - 20} more" if len(c["adds"]) > 20 else ""))
    return out


def build(ctx: Ctx, repo: Path, rev: str, contract: dict, out: Path, links: dict[str, tuple[str, str]],
          declared: list[str]) -> dict:
    """Write the candidate of one repository; links: submodule path -> (public commit, public URL)."""
    if out.exists() and any(out.iterdir()):
        raise Refusal.coded("usage", f"{out} is not empty")
    rule_refusals(repo, rev, contract)
    project = project_of(ctx)
    locals_ = local_paths(contract)
    runs = run_selection(repo, rev, contract, project, locals_)
    out.mkdir(parents=True, exist_ok=True)
    files, inputs = [], []
    named = {f["public"] for f in contract.get("file", [])}
    catalog = is_catalog(repo, rev)
    for public, (content, mode, origin, source_path) in sorted(tree_selection(repo, rev, contract, locals_).items()):
        if public in named:
            continue  # a [[file]] for the same path decides (with its edits)
        if source_path:
            content_check(source_path, project, f"[[tree]] {origin.split(' ')[0]}: {source_path}")
        if catalog and source_path == RULES_FILE:
            content = public_rules(repo, rev, contract, content)
        target = out / public
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(content)
        target.chmod(0o755 if mode == "100755" else 0o644)
        files.append({"path": public, "from": origin, "sha256": hashlib.sha256(content).hexdigest(), "edits": 0})
    for entry in contract.get("file", []):
        kind, _, rel = entry["from"].partition(":")
        mode = "100644"
        if kind == "source":
            path = rel.strip("/")
            if under(path, RUNS_DIR):
                raise Refusal.coded("contract", f"[[file]] {entry['public']}: {path} is a run record; a run is selected by its "
                                    "own [[run]] (id, files), never by [[file]] or [[tree]]")
            for l in locals_:
                if under(path, l):
                    raise Refusal.coded("contract", f"[[file]] {entry['public']}: {path} is kept local ([[local]] {l})")
            content_check(path, project, f"[[file]] {entry['public']}")
            content, mode = blob(repo, rev, rel)
            if rel.strip("/") == RULES_FILE and is_catalog(repo, rev):
                if entry.get("edit"):
                    raise Refusal.coded("contract", f"{entry['public']}: the public {RULES_FILE} of a catalog is derived from its "
                                        "rules and takes no [[file.edit]] (agdev docs/external-publication.md, The owner's words)")
                content = public_rules(repo, rev, contract, content)
        elif kind == "overlay":
            content, mode = blob(repo, rev, f"{OVERLAY}/{rel}")
        elif kind == "workspace":
            content = admitted(ctx, rel, entry["sha256"])
            inputs.append({"path": rel, "sha256": entry["sha256"]})
        else:
            raise Refusal.coded("contract", f"unknown source kind in {entry['from']!r}")
        for edit in entry.get("edit", []):
            text = content.decode("utf-8")
            found = text.count(edit["old"])
            if found != edit.get("count", 1):
                raise Refusal.coded("contract", f"{entry['public']}: edit expects {edit.get('count', 1)} occurrence(s) of "
                              f"{edit['old'][:60]!r}, found {found}")
            content = text.replace(edit["old"], edit["new"]).encode("utf-8")
        target = out / entry["public"]
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(content)
        target.chmod(0o755 if mode == "100755" else 0o644)
        files.append({"path": entry["public"], "from": entry["from"], "sha256": hashlib.sha256(content).hexdigest(),
                      "edits": len(entry.get("edit", []))})
    for public, content, mode, run_id in runs:
        if public in named or (out / public).exists():
            raise Refusal.coded("contract", f"[[run]] {run_id}: {public} is selected twice")
        target = out / public
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(content)
        target.chmod(0o644)
        files.append({"path": public, "from": f"run:{run_id}", "sha256": hashlib.sha256(content).hexdigest(), "edits": 0})
    gitlinks = []
    if declared:
        text = ""
        for path in sorted(declared):
            if path not in links:
                raise Refusal.coded("child-not-public", f"no public commit for submodule {path}")
            commit, url = links[path]
            text += f'[submodule "{path}"]\n\tpath = {path}\n\turl = {url}\n'
            gitlinks.append((path, commit))
        (out / ".gitmodules").write_text(text, encoding="utf-8")
        files.append({"path": ".gitmodules", "from": "generated", "sha256": hashlib.sha256(text.encode()).hexdigest(),
                      "edits": 0})
    return {"files": files, "inputs": inputs, "gitlinks": gitlinks}


def secret_values(ctx: Ctx, contract: dict, extra: list[str]) -> list[tuple[str, str]]:
    values = []
    for name in list(contract.get("local_secrets", [])) + extra:
        env = ctx.workspace / name
        if not env.is_file():
            continue
        for line in env.read_text(encoding="utf-8").splitlines():
            if "=" in line and not line.strip().startswith("#"):
                key, _, value = line.partition("=")
                key, value = key.strip(), value.strip()
                if len(value) >= 6:
                    values.append((f"{env.name} {key}", value))
                    if "://" in value:
                        values.append((f"{env.name} {key} host",
                                       value.split("://", 1)[1].split("/", 1)[0].split(":", 1)[0]))
    return values


def check(ctx: Ctx, out: Path, contract: dict, extra_secrets: list[str], kept: list[dict] | None = None) -> list[dict]:
    """Findings not covered by an [[allow]]: forbidden words, secret values, and (improve_publish p1) the id of
    every project this installation keeps private, labelled private:<id>. Allowed private names go to `kept`."""
    allowed = contract.get("allow", [])
    findings = []
    secrets = secret_values(ctx, contract, extra_secrets)
    private = [(f"private:{p}", private_name_re(p)) for p in sorted(private_projects())]
    for path in sorted(p for p in out.rglob("*") if p.is_file() and ".git" not in p.relative_to(out).parts):
        rel = path.relative_to(out).as_posix()
        text = path.read_bytes().decode("utf-8", errors="replace")
        lower = text.lower()
        found = [word for word in contract.get("forbidden", []) if word.lower() in lower]
        found += [label for label, value in secrets if value in text]
        found += [label for label, pattern in private if pattern.search(text)]
        for label in found:
            allow = next((a for a in allowed if fnmatch(rel, a["file"]) and a["found"] == label), None)
            if not allow:
                finding = {"file": rel, "found": label}
                if label.startswith("private:"):
                    finding["why"] = "names a project kept private: generalize it, or record why the name is needed " \
                                     f"([[allow]] file = \"{rel}\", found = \"{label}\", why = \"…\")"
                findings.append(finding)
            elif label.startswith("private:") and kept is not None:
                kept.append({"file": rel, "found": label, "why": allow.get("why", "")})
    return findings


def tree_of(repo: Path, folder: Path, gitlinks) -> str:
    """Git tree id of a candidate folder plus its gitlinks (a folder cannot hold a gitlink)."""
    with tempfile.TemporaryDirectory() as tmp:
        env = {"GIT_INDEX_FILE": str(Path(tmp) / "index"), "GIT_DIR": str(repo / ".git"), "GIT_WORK_TREE": str(folder)}
        git(folder, "add", "-A", ".", env=env)
        for path, commit in gitlinks:
            git(folder, "update-index", "--add", "--cacheinfo", f"160000,{commit},{path}", env=env)
        return git(folder, "write-tree", env=env).decode().strip()


def candidate_tree(ctx: Ctx, node_repo: Path, rev: str, contract_path: str, checkout: Path,
                   links: dict[str, tuple[str, str]], checked: bool, extra_secrets: list[str]) -> tuple[dict, str]:
    contract = load_contract(node_repo, rev, contract_path)
    declared = [s["path"] for s in contract.get("submodule", [])]
    with tempfile.TemporaryDirectory() as tmp:
        out = Path(tmp) / "candidate"
        info = build(ctx, node_repo, rev, contract, out, links, declared)
        if checked:
            kept: list[dict] = []
            findings = check(ctx, out, contract, extra_secrets, kept)
            if findings:
                raise Refusal.coded("check-failed", f"candidate check failed for {identity_of(node_repo)}@{rev[:12]}: "
                                    + json.dumps(findings, ensure_ascii=False))
            info["private_names"] = {"searched": sorted(private_projects()), "allowed": kept}
        return info, tree_of(checkout, out, info["gitlinks"])


# ---------------------------------------------------------------- public checkouts

def ensure_checkout(path: Path, destination: str, branch: str) -> Path:
    if not (path / ".git").exists():
        path.mkdir(parents=True, exist_ok=True)
        git(path, "init", "-q", "-b", branch)
        git(path, "remote", "add", "origin", destination)
    origin = git(path, "config", "--get", "remote.origin.url", check=False).decode().strip()  # as configured
    if origin != destination:
        raise Refusal.coded("checkout-state", f"{path}: origin is {origin}, the contract says {destination}")
    return path


def remote_head(path: Path, branch: str) -> str | None:
    result = subprocess.run(["git", "-C", str(path), "ls-remote", "origin", f"refs/heads/{branch}"], capture_output=True)
    if result.returncode != 0:
        err = result.stderr.decode(errors="replace").strip()
        if "not found" in err.lower() or "does not exist" in err.lower():
            return None
        raise Refusal.coded("infrastructure", f"cannot read {branch} of {path}'s origin: {err}")
    lines = result.stdout.decode().split()
    return lines[0] if lines else None


def repo_state(journal: dict, node: Node, checkout: Path, ctx: Ctx) -> dict:
    return journal["repositories"].setdefault(node.id, {
        "name": node.name, "internal_url": node.url, "destination": node.contract["destination"],
        "branch": node.contract["branch"], "checkout": checkout.relative_to(ctx.workspace).as_posix(),
        "contract": node.contract_path, "publications": []})


def entries(state: dict, status: str) -> list[dict]:
    return [p for p in state["publications"] if p.get("status") == status]


def reconcile(state: dict, checkout: Path) -> list[str]:
    """A staged entry already on the remote is completed (lost confirmation), never published twice."""
    notes = []
    for entry in entries(state, "staged"):
        remote = remote_head(checkout, state["branch"])
        if remote == entry["public_commit"]:
            entry.update(status="published", published_at=now(), remote_commit=remote,
                         notes=f"{now()} reconciled: the remote branch already held the staged commit")
            notes.append(f"{state['name']}: staged {entry['public_commit'][:12]} found on the remote; recorded as published")
    return notes


def links_for(node: Node, results: dict[str, dict], journal: dict) -> dict[str, tuple[str, str]]:
    links = {}
    for child in node.children:
        links[child.path] = (results[child.id]["public_commit"],
                             public_url(journal["repositories"][child.id]["destination"], node.contract["destination"]))
    return links


def public_url(destination: str, parent: str) -> str:
    """The URL a public .gitmodules gives a child: `../<name>.git` when the child is published under the same
    host and owner as its parent (Git and agdev's acquisition resolve it against wherever the parent was cloned
    from, so a copy of the pair keeps working), else the child's destination as written."""
    child_dir, _, child_name = destination.rstrip("/").rpartition("/")
    parent_dir = parent.rstrip("/").rpartition("/")[0]
    if "://" in destination and child_dir.lower() == parent_dir.lower() and child_name:
        return "../" + (child_name if child_name.endswith(".git") else child_name + ".git")
    return destination


def recorded_scope(scope: dict, scope_answer: str | None) -> list[dict]:
    """The scope a publication records: every selection with the answer it is published under."""
    answer = f"answer:{scope_answer.split('#', 1)[0]}" if scope_answer else None
    return [{k: v for k, v in {**i, "answer": i.get("answer") or answer}.items() if v is not None} for i in scope["items"]]


def stage_repo(ctx: Ctx, root: Node, node: Node, journal: dict, results: dict, message: str, op: dict,
               extra_secrets: list[str], scope: dict | None = None, scope_answer: str | None = None) -> dict:
    checkout = checkout_of(ctx, root, node, journal)
    state = repo_state(journal, node, checkout, ctx)
    branch = state["branch"]
    ensure_checkout(checkout, state["destination"], branch)
    op["notes"] += reconcile(state, checkout)
    if entries(state, "conflict"):
        raise Refusal.coded("conflict", f"{node.id} has a recorded conflict: inspect {checkout}, then resolve or abort")
    links = links_for(node, results, journal)
    gl_record = [{"path": c.path, "repository": c.id, "source_rev": c.rev, "public_commit": links[c.path][0]}
                 for c in node.children]
    published = entries(state, "published")
    for entry in reversed(published):
        if entry["source_rev"] == node.rev and entry.get("gitlinks", []) == gl_record:
            return {"public_commit": entry["public_commit"], "action": "already published"}
    info, tree = candidate_tree(ctx, node.repo, node.rev, node.contract_path, checkout, links, True, extra_secrets)
    previous = published[-1] if published else None
    record = recorded_scope(scope, scope_answer) if scope else None
    staged = entries(state, "staged")
    if previous and previous["candidate_tree"] == tree:
        pair = {"source_rev": node.rev, "candidate_tree": tree, "public_commit": previous["public_commit"],
                "gitlinks": gl_record, "status": "published", "reused_from": previous["source_rev"],
                "published_at": now(), "notes": "internal-only change: the candidate equals the last published one",
                **({"scope": record} if record is not None else {})}
        state["publications"] = [p for p in state["publications"] if p.get("status") != "staged"] + [pair]
        return {"public_commit": previous["public_commit"], "action": "unchanged candidate; pair recorded"}
    if staged and staged[-1]["candidate_tree"] == tree and staged[-1].get("gitlinks", []) == gl_record and \
            git(checkout, "rev-parse", "HEAD").decode().strip() == staged[-1]["public_commit"]:
        staged[-1]["source_rev"] = node.rev
        return {"public_commit": staged[-1]["public_commit"], "action": "already staged"}
    if git(checkout, "status", "--porcelain").strip():
        raise Refusal.coded("checkout-state", f"{checkout} has uncommitted changes: resolve them first")
    identity_env = {"GIT_AUTHOR_DATE": now(), "GIT_COMMITTER_DATE": now()}
    body = f"{message}\n\nSource: {node.name} {node.rev[:12]} (internal), contract {node.contract_path}."
    head = git(checkout, "rev-parse", "--verify", "-q", "HEAD", check=False).decode().strip()
    entry = {"source_rev": node.rev, "candidate_tree": tree, "destination": state["destination"], "branch": branch,
             "inputs": info["inputs"], "files": len(info["files"]), "gitlinks": gl_record,
             "checks": {"forbidden_and_secret_values": "passed", "private_names": info.get("private_names")},
             "operation": op["id"], "staged_at": now(), **({"scope": record} if record is not None else {})}
    if previous is None:
        if head and not (staged and staged[-1]["public_commit"] == head):
            raise Refusal.coded("checkout-state", f"{checkout} has commits but the journal records no publication: inspect it first")
        if remote_head(checkout, branch):
            raise Refusal.coded("checkout-state", f"{state['destination']} already has {branch}: never overwritten; inspect it first")
        commit = git(checkout, "commit-tree", tree, "-m", body, env=identity_env).decode().strip()
        git(checkout, "update-ref", f"refs/heads/{branch}", commit)
        git(checkout, "checkout", "-q", "-f", branch)
        git(checkout, "reset", "-q", "--hard", branch)
        entry.update(public_base=None, public_changes_since_base=None)
    else:
        base = previous["public_commit"]
        git(checkout, "fetch", "-q", "origin", branch)
        remote = git(checkout, "rev-parse", f"origin/{branch}").decode().strip()
        local = head
        if staged and staged[-1]["public_commit"] == local and local != remote:
            git(checkout, "reset", "-q", "--hard", remote)  # replace the unpushed candidate
            local = remote
        if local != remote:
            raise Refusal.coded("checkout-state", f"{checkout}: local {branch} {local[:12]} differs from origin {remote[:12]} and is not "
                          "the staged candidate: reconcile first (unexplained edits are never restaged over)")
        if not git_ok(checkout, "merge-base", "--is-ancestor", base, remote):
            raise Refusal.coded("stale-public-head", f"{state['destination']} {branch} no longer contains the last publication {base[:12]}")
        changes = git(checkout, "diff", "--stat", base, remote).decode().strip()
        prev_links = {g["path"]: (g["public_commit"], public_url(journal["repositories"][g["repository"]]["destination"],
                                                                  node.contract["destination"]))
                      for g in previous.get("gitlinks", [])}
        _, old_tree = candidate_tree(ctx, node.repo, previous["source_rev"], node.contract_path, checkout, prev_links,
                                     False, extra_secrets)
        if old_tree == tree:  # the previous candidate, rebuilt by this tool, is this one: no change to apply
            pair = {"source_rev": node.rev, "candidate_tree": tree, "public_commit": previous["public_commit"],
                    "gitlinks": gl_record, "status": "published", "reused_from": previous["source_rev"],
                    "published_at": now(), "notes": "the previous candidate rebuilt today equals this one: nothing to publish",
                    **({"scope": record} if record is not None else {})}
            state["publications"] = [p for p in state["publications"] if p.get("status") != "staged"] + [pair]
            return {"public_commit": previous["public_commit"], "action": "unchanged candidate; pair recorded"}
        old = git(checkout, "commit-tree", old_tree, "-m", "previous candidate", env=identity_env).decode().strip()
        new = git(checkout, "commit-tree", tree, "-p", old, "-m", body, env=identity_env).decode().strip()
        entry.update(public_base=remote, public_changes_since_base=changes or None,
                     desired={"from_candidate": old, "to_candidate": new})
        picked = subprocess.run(["git", "-C", str(checkout), "cherry-pick", "--allow-empty", "--empty=drop", new],
                                capture_output=True, env={**os.environ, **identity_env})
        if picked.returncode != 0:
            conflicted = git(checkout, "diff", "--name-only", "--diff-filter=U").decode().split()
            entry.update(status="conflict", conflict={"files": conflicted, "at": now(), "base": remote,
                                                      "output": picked.stdout.decode(errors="replace")[-2000:]})
            git(checkout, "update-ref", f"refs/agdev/desired/{new[:12]}", new)  # keep the desired delta reachable
            state["publications"] = [p for p in state["publications"] if p.get("status") != "staged"] + [entry]
            op["status"] = "conflict"
            ctx.write_journal(journal)
            raise Refusal.coded("conflict", f"{node.id}: the internal change conflicts with the public head in {conflicted}. Inspect "
                          f"{checkout} (git status; base {remote[:12]}, desired {old[:12]}..{new[:12]}). Either resolve, "
                          "commit, and run `resolve --repo ID --note …`, or `abort --repo ID` and record the decision "
                          "in the contract/overlay or source, then stage again")
        commit = git(checkout, "rev-parse", "HEAD").decode().strip()
        if commit == remote:  # the public head already contains the change (e.g. an imported public fix)
            entry.update(public_commit=remote, public_tree=git(checkout, "rev-parse", f"{remote}^{{tree}}").decode().strip(),
                         status="published", published_at=now(), remote_commit=remote,
                         notes="the public head already contains this candidate's change; nothing to push")
            state["publications"] = [p for p in state["publications"] if p.get("status") != "staged"] + [entry]
            return {"public_commit": remote, "action": "already contained in the public head"}
    entry.update(public_commit=commit, public_tree=git(checkout, "rev-parse", f"{commit}^{{tree}}").decode().strip(),
                 status="staged")
    state["publications"] = [p for p in state["publications"] if p.get("status") != "staged"] + [entry]
    return {"public_commit": commit, "action": "staged"}


SCOPE_ANSWER_RE = None


def cmd_stage(ctx: Ctx, rev: str, message: str, extra_secrets: list[str], owner: str | None = None,
              take_over: str | None = None, scope_answer: str | None = None) -> dict:
    disclosure_refusal(ctx)
    with ctx.lock():
        journal = ctx.read_journal()
        previous = last_stage(journal)
        held = previous.get("owner") if previous else None
        if previous and previous["status"] in UNFINISHED and held and held != owner and not take_over:
            raise Refusal.coded("owner", f"the last staging ({previous['id']}, {previous['status']}) belongs to {held} "
                                "and is unfinished: restaging would replace its candidate. Wait for it, or pass "
                                "--take-over <reason> once that owner has finished")
        root = discover(ctx, rev)
        order = postorder(root)
        problems = validate(ctx, root, journal)
        if problems:
            raise Refusal.coded("graph", "graph problems: " + "; ".join(problems))
        if scope_answer:
            import re
            if not re.match(r"^[a-z0-9][a-z0-9_.-]*/[a-z0-9][a-z0-9_.-]*/run-[0-9]+#[A-Za-z0-9_.-]+$", scope_answer):
                raise Refusal.coded("usage", f"--scope-answer {scope_answer!r}: <project>/<workflow>/<run>#<question>, the run "
                                    "and its question the owner or Omni answered (e.g. publisher/publish/run-031#q1)")
        # improve_publish p2: the scope change of every repository of the graph, before anything is written.
        scopes = {node.id: scope_of(ctx, node, journal) for node in order}
        ungrounded = [f"{nid}: {m}" for nid, sc in scopes.items() for m in sc["not_grounded"]]
        changed = {nid: sc for nid, sc in scopes.items() if sc["change"]}
        if ungrounded and (GROUNDS_REQUIRED or changed):
            raise Refusal.coded("contract", "not grounded (every selection names why it is public: because = rule:<id> | "
                                "answer:<project>/<workflow>/<run> | project): " + "; ".join(ungrounded))
        if changed and not scope_answer:
            raise Refusal.coded("scope", "this candidate widens what is public; it needs one answer on exactly this list "
                                "(ask once, then stage --scope-answer <run>#<question>):\n" + "\n".join(
                                    f"{nid}:\n" + "\n".join("  " + l for l in change_lines(sc)) for nid, sc in changed.items()))
        holds = ctx.read_holds()
        for node in order:  # improve_publish p3: what the owner asked to keep local is not staged while its change is pending
            hold_refusal(held_selection(holds, node.id, selected_source_paths(node.repo, node.rev, node.contract)),
                         node.id, node.rev, "this candidate")
        op = {"id": now(), "command": "stage", "root": root.id, "root_rev": root.rev,
              "order": [n.id for n in order], "status": "staging", "notes": [], "repositories": {}}
        if owner:
            op["owner"] = owner
        if changed:
            op["scope_answer"] = scope_answer
            op["scope_change"] = {nid: [{k: c[k] for k in ("kind", "group", "adds", "because") if k in c} |
                                        {"selection": label_of(c["kind"], c)} for c in sc["change"]] for nid, sc in changed.items()}
        if previous and previous["status"] in UNFINISHED and held != owner:
            op["took_over"] = {"operation": previous["id"], "owner": held, "status": previous["status"],
                               "reason": take_over or "no owner recorded on it"}
            previous["status"] = "superseded"
            previous.setdefault("notes", []).append(f"{op['id']}: superseded by {owner or 'an unowned staging'}")
        journal.setdefault("operations", []).append(op)
        results: dict[str, dict] = {}
        for node in order:
            results[node.id] = stage_repo(ctx, root, node, journal, results, message, op, extra_secrets,
                                          scopes[node.id], scope_answer)
            op["repositories"][node.id] = {"source_rev": node.rev, **results[node.id]}
            ctx.write_journal(journal)
        op["status"] = "staged" if any(r["action"] == "staged" for r in results.values()) else "nothing to push"
        ctx.write_journal(journal)
        settled = False
        for node in order:
            settled |= settle_holds(ctx, holds, node.id, node.rev, released=results[node.id]["action"] != "staged")
        if settled:
            ctx.write_holds(holds)
        return op


# ---------------------------------------------------------------- resolve / abort

def conflict_of(journal: dict, repo_id: str) -> tuple[dict, dict]:
    state = journal["repositories"].get(repo_id)
    found = entries(state, "conflict") if state else []
    if not found:
        raise Refusal.coded("usage", f"{repo_id} has no recorded conflict")
    return state, found[-1]


def cmd_resolve(ctx: Ctx, repo_id: str, note: str, extra_secrets: list[str], owner: str | None = None,
                take_over: str | None = None) -> dict:
    with ctx.lock():
        journal = ctx.read_journal()
        check_owner(journal, owner, "resolve", take_over)
        state, entry = conflict_of(journal, repo_id)
        checkout = ctx.workspace / state["checkout"]
        if (checkout / ".git" / "CHERRY_PICK_HEAD").exists():
            raise Refusal.coded("conflict", f"{checkout}: finish the cherry-pick first (git add …; git cherry-pick --continue)")
        if git(checkout, "status", "--porcelain").strip():
            raise Refusal.coded("checkout-state", f"{checkout} has uncommitted changes")
        head = git(checkout, "rev-parse", "HEAD").decode().strip()
        base = entry["conflict"]["base"]
        if not git_ok(checkout, "merge-base", "--is-ancestor", base, head):
            raise Refusal.coded("conflict", f"{checkout} HEAD {head[:12]} does not descend from the public base {base[:12]}")
        source_repo = source_repo_for(ctx, journal, repo_id)
        contract = load_contract(source_repo, entry["source_rev"], state.get("contract", DEFAULT_CONTRACT))
        hold_refusal(held_selection(ctx.read_holds(), repo_id, selected_source_paths(source_repo, entry["source_rev"], contract)),
                     repo_id, entry["source_rev"], "the conflicted candidate")
        with tempfile.TemporaryDirectory() as tmp:
            out = Path(tmp) / "resolved"
            out.mkdir()
            subprocess.run(f"git -C '{checkout}' archive {head} | tar -x -C '{out}'", shell=True, check=True)
            findings = check(ctx, out, contract, extra_secrets)
        if findings:
            raise Refusal.coded("check-failed", "the resolved tree fails the check: " + json.dumps(findings, ensure_ascii=False))
        entry.update(status="staged", public_commit=head,
                     public_tree=git(checkout, "rev-parse", f"{head}^{{tree}}").decode().strip(),
                     resolution={"note": note, "at": now(), "files": entry["conflict"]["files"], "commit": head})
        for op in reversed(journal.get("operations", [])):
            if op.get("id") == entry.get("operation"):
                op["status"] = "staged"  # pushable again; later repositories of that graph were not staged yet
                op["notes"].append(f"{repo_id}: conflict resolved ({head[:12]})")
                break
        ctx.write_journal(journal)
        return entry


def source_repo_for(ctx: Ctx, journal: dict, repo_id: str) -> Path:
    """The local repository holding a graph member's objects: the root, or the submodule checkout of the last
    operation's graph."""
    url = git(ctx.source, "remote", "get-url", "origin").decode().strip()
    if identity(url) == repo_id:
        return ctx.source
    root = discover(ctx, journal["operations"][-1]["root_rev"])
    for node in postorder(root):
        if node.id == repo_id:
            return node.repo
    raise Refusal.coded("usage", f"{repo_id} is not in the graph of the last operation")


def cmd_abort(ctx: Ctx, repo_id: str, owner: str | None = None, take_over: str | None = None) -> dict:
    with ctx.lock():
        journal = ctx.read_journal()
        check_owner(journal, owner, "abort", take_over)
        state, entry = conflict_of(journal, repo_id)
        checkout = ctx.workspace / state["checkout"]
        if (checkout / ".git" / "CHERRY_PICK_HEAD").exists():
            git(checkout, "cherry-pick", "--abort")
        git(checkout, "reset", "-q", "--hard", entry["conflict"]["base"])
        entry.update(status="aborted", aborted_at=now())
        for op in reversed(journal.get("operations", [])):
            if op.get("id") == entry.get("operation"):
                op["status"] = "aborted"
                break
        ctx.write_journal(journal)
        return entry


# ---------------------------------------------------------------- push

def verify_public(ctx: Ctx, journal: dict, link: dict) -> None:
    """A gitlink's commit must be reachable from its public repository's branch."""
    state = journal["repositories"][link["repository"]]
    checkout = ctx.workspace / state["checkout"]
    git(checkout, "fetch", "-q", "origin", state["branch"])
    if not git_ok(checkout, "merge-base", "--is-ancestor", link["public_commit"], f"origin/{state['branch']}"):
        raise Refusal.coded("child-not-public", f"{link['path']} -> {link['public_commit'][:12]} is not on {state['destination']} "
                      f"{state['branch']} yet: publish {link['repository']} first")


def push_repo(ctx: Ctx, journal: dict, repo_id: str) -> str:
    state = journal["repositories"][repo_id]
    entry = entries(state, "staged")[-1]
    checkout = ctx.workspace / state["checkout"]
    for link in entry.get("gitlinks", []):
        verify_public(ctx, journal, link)
    remote_before = remote_head(checkout, entry["branch"])
    if remote_before == entry["public_commit"]:
        entry.update(status="published", published_at=now(), remote_commit=remote_before,
                     notes=f"{now()} reconciled: already on the remote before pushing (lost confirmation)")
        return "reconciled (already on the remote)"
    if remote_before != entry["public_base"]:
        raise Refusal.coded("stale-public-head", f"{state['destination']} {entry['branch']} is {remote_before}, expected {entry['public_base']}: "
                      "public commits arrived since staging; stage again (they are preserved)")
    head = git(checkout, "rev-parse", "HEAD").decode().strip()
    if head != entry["public_commit"]:
        raise Refusal.coded("checkout-state", f"{checkout} HEAD {head[:12]} is not the staged commit (edited after staging): stage again")
    result = subprocess.run(["git", "-C", str(checkout), "push", "origin", f"{head}:refs/heads/{entry['branch']}"],
                            capture_output=True)
    remote_after = remote_head(checkout, entry["branch"])  # decides, whatever push printed
    if remote_after != head:
        entry["notes"] = f"{now()} push exit {result.returncode}; origin is {remote_after}"
        ctx.write_journal(journal)
        raise Refusal.coded("infrastructure", entry["notes"] + "\n" + result.stderr.decode(errors="replace"))
    entry.update(status="published", published_at=now(), remote_commit=remote_after)
    return "pushed"


def cmd_push(ctx: Ctx, stop_before: str | None, owner: str | None = None, operation: str | None = None,
             take_over: str | None = None) -> dict:
    disclosure_refusal(ctx)
    with ctx.lock():
        journal = ctx.read_journal()
        op = last_stage(journal)
        if not op:
            raise Refusal.coded("usage", "nothing staged")
        if operation and op["id"] != operation:
            raise Refusal.coded("owner", f"the last staging is {op['id']} ({op.get('owner') or 'no owner'}), not {operation}: "
                                "the candidate you assessed was replaced; read status and stage again")
        check_owner(journal, owner, "push", take_over)
        if op["status"] in ("conflict", "aborted"):
            raise Refusal.coded("conflict", f"the last staging is {op['status']}: resolve, or stage again")
        holds = ctx.read_holds()
        done = {}
        for repo_id in op["order"]:
            state = journal["repositories"][repo_id]
            if not entries(state, "staged"):
                done[repo_id] = "nothing staged"
                continue
            if stop_before == repo_id:
                op["status"] = "partial"
                op.setdefault("boundaries", []).append({"stopped_before": repo_id, "at": now()})
                op["pushed"] = done
                ctx.write_journal(journal)
                return op
            staged = entries(state, "staged")[-1]
            repo = source_repo_for(ctx, journal, repo_id)
            contract = load_contract(repo, staged["source_rev"], state.get("contract", DEFAULT_CONTRACT))
            hold_refusal(held_selection(holds, repo_id, selected_source_paths(repo, staged["source_rev"], contract)),
                         repo_id, staged["source_rev"], f"the staged candidate ({op['id']})")
            done[repo_id] = push_repo(ctx, journal, repo_id)
            ctx.write_journal(journal)
            if settle_holds(ctx, holds, repo_id, staged["source_rev"], released=True):
                ctx.write_holds(holds)
        op.update(status="published", pushed=done, completed_at=now())
        ctx.write_journal(journal)
        return op


# ---------------------------------------------------------------- holds (improve_publish p3)
#
# A hold is coordination, not policy: the owner asked (from the Catalog page) to keep a source path local from now on,
# and the owning agent's contract change (a [[local]]) is not integrated yet. While a hold is `held` or `integrated`,
# no candidate that still selects the path is staged, resolved or pushed (code hold). It becomes `integrated` when a
# stage reads a revision that no longer selects it, and `released` when a publication from such a revision is
# complete (pushed, or nothing to push). Only the hold is released; the [[local]] stays in the contract.

ACTIVE_HOLDS = ("held", "integrated")


def selected_source_paths(repo: Path, rev: str, contract: dict) -> list[str]:
    """Every source path the contract selects at rev (trees minus excludes and [[local]], files, runs, submodules)."""
    listing = [r.split("\t", 1)[1] for r in filter(None, git(repo, "ls-tree", "-r", "-z", "--full-tree", rev).decode().split("\0"))]
    locals_ = local_paths(contract)
    out: list[str] = []
    for item in scope_items(repo, rev, contract):
        out += [x for x in item_paths(item, listing, locals_) if not x.startswith("workspace:")]
    return out


def held_selection(holds: list[dict], repo_id: str, paths: list[str]) -> list[tuple[dict, list[str]]]:
    found = []
    for h in holds:
        if h.get("state") in ACTIVE_HOLDS and h.get("repository") == repo_id:
            hit = [p for p in paths if under(p, h["path"]) or under(h["path"], p)]
            if hit:
                found.append((h, hit))
    return found


def hold_refusal(found: list[tuple[dict, list[str]]], repo_id: str, rev: str, what: str) -> None:
    if found:
        raise Refusal.coded("hold", f"{repo_id}@{rev[:12]}: {what} selects what the owner asked to keep local and whose "
                            "contract change is not integrated: " + "; ".join(
                                f"{h['path']} (request {h['request']} by {h.get('by')}, {h.get('at')}; selects "
                                f"{', '.join(paths[:5])}{' …' if len(paths) > 5 else ''})" for h, paths in found)
                            + ". Stage again from a revision whose contract keeps it local ([[local]])")


def public_holds(repo: Path, journal_state: dict | None, contract_path: str, path: str) -> dict | None:
    """The newest journaled publication of a repository whose selection held a source path, with whether it is the
    public head's (the last publication). None when no journaled publication held it."""
    published = entries(journal_state, "published") if journal_state else []
    for i, entry in enumerate(reversed(published)):
        scope = entry.get("scope")
        try:
            if scope is None:
                old = load_contract(repo, entry["source_rev"], contract_path)
                scope = scope_items(repo, entry["source_rev"], old)
            listing = [r.split("\t", 1)[1] for r in filter(None, git(repo, "ls-tree", "-r", "-z", "--full-tree", entry["source_rev"]).decode().split("\0"))]
        except (Refusal, subprocess.CalledProcessError):
            continue
        locals_ = []
        hit = False
        for item in scope:
            if item["kind"] == "run":
                hit = any(under(f"{RUNS_DIR}/{item['id']}/{n}", path) for n in item.get("files", RUN_FILES))
            elif item["kind"] == "submodule":
                hit = under(item["path"], path) or under(path, item["path"])
            else:
                hit = any(under(x, path) for x in item_paths(item, listing, locals_))
            if hit:
                break
        if hit:
            return {"public_commit": entry["public_commit"], "source_rev": entry["source_rev"],
                    "published_at": entry.get("published_at"), "head": i == 0}
    return None


def cmd_hold(ctx: Ctx, action: str, repo_id: str | None, path: str | None, request: str | None, by: str | None,
             note: str | None) -> dict:
    """hold add | withdraw | list. add: the owner's request to keep `path` local from now on, recorded under the lock
    (waiting up to 60 s for a running operation), with what it now blocks and whether the public head holds it."""
    if action == "list":
        return {"holds": ctx.read_holds()}
    if not request:
        raise Refusal.coded("usage", "hold needs --request <id> (the page's request)")
    with ctx.lock(wait=60):
        holds = ctx.read_holds()
        journal = ctx.read_journal()
        if action == "withdraw":
            mine = [h for h in holds if h.get("request") == request and h.get("state") in ACTIVE_HOLDS]
            if not mine:
                raise Refusal.coded("usage", f"no active hold of request {request}")
            for h in mine:
                h.update(state="withdrawn", withdrawn={"by": by, "at": now(), "why": note or ""})
            ctx.write_holds(holds)
            return {"holds": mine}
        if action != "add" or not path:
            raise Refusal.coded("usage", "hold add --repo ID --path P --request R --by A [--note N]")
        path = path.strip("/")
        if not path or path.startswith(".") or ".." in path.split("/"):
            raise Refusal.coded("usage", f"--path {path!r}: a source path of the repository")
        root = discover(ctx, "HEAD")
        nodes = {n.id: n for n in postorder(root)}
        repo_id = repo_id or root.id
        if repo_id not in nodes:
            raise Refusal.coded("usage", f"{repo_id} is not a repository of this graph ({', '.join(nodes)})")
        node = nodes[repo_id]
        same = next((h for h in holds if h.get("repository") == repo_id and h.get("path") == path and h.get("state") in ACTIVE_HOLDS), None)
        if same:
            hold, duplicate = same, True
        else:
            hold = {"request": request, "repository": repo_id, "path": path, "by": by, "at": now(), "note": note or "",
                    "state": "held"}
            holds.append(hold)
            duplicate = False
        selected_now = [p for p in selected_source_paths(node.repo, node.rev, node.contract) if under(p, path) or under(path, p)]
        if not selected_now and not same:
            hold["state"], hold["integrated"] = "integrated", {"rev": node.rev, "at": now(), "note": "not selected when asked"}
        ctx.write_holds(holds)
        state = journal["repositories"].get(repo_id)
        staged = entries(state, "staged")[-1] if state and entries(state, "staged") else None
        blocked = None
        if staged:
            try:
                old = load_contract(node.repo, staged["source_rev"], node.contract_path)
                hit = [p for p in selected_source_paths(node.repo, staged["source_rev"], old) if under(p, path)]
                if hit:
                    blocked = {"operation": staged.get("operation"), "public_commit": staged["public_commit"], "paths": hit[:20]}
            except Refusal:
                pass
        return {"hold": hold, "duplicate": duplicate, "selected_now": selected_now[:50], "selected_count": len(selected_now),
                "staged_blocked": blocked, "public": public_holds(node.repo, state, node.contract_path, path)}


def settle_holds(ctx: Ctx, holds: list[dict], node_id: str, rev: str, released: bool) -> bool:
    """After a stage or push of a repository at rev (which passed the hold check): held -> integrated; integrated ->
    released when the publication is complete. Returns whether anything changed."""
    changed = False
    for h in holds:
        if h.get("repository") != node_id:
            continue
        if h.get("state") == "held":
            h.update(state="integrated", integrated={"rev": rev, "at": now()})
            changed = True
        if released and h.get("state") == "integrated":
            h.update(state="released", released={"rev": rev, "at": now()})
            changed = True
    return changed


GROUP_CODE = (".py", ".ts", ".js", ".mjs", ".sh", ".gd", ".gdshader", ".rs", ".go", ".c", ".h", ".cpp", ".css", ".html")


def group_of(item: dict, paths: list[str]) -> str:
    """Display only: run records, workflows, code, other files."""
    if item["kind"] == "run":
        return "run records"
    if paths and all(under(p, WORKFLOWS_DIR) for p in paths):
        return "workflows"
    if item["kind"] == "submodule" or item["kind"] == "tree":
        return "code"
    return "code" if paths and paths[0].lower().endswith(GROUP_CODE) else "other files"


def rule_publicity(repo: Path, rev: str, contract: dict) -> list[dict]:
    """Per rule of a catalog's rules.yaml: whether its public form exists in this candidate and why (public_rules)."""
    raw = git(repo, "cat-file", "blob", f"{rev}:{RULES_FILE}", check=False)
    if not raw:
        return []
    doc = read_yaml_rules(raw, f"{RULES_FILE} at {rev[:12]}")
    _, selected = selected_sources(repo, rev, contract)
    rules_selected = RULES_FILE in selected or any(f.get("from") == f"source:{RULES_FILE}" for f in contract.get("file", []))
    out = []
    for r in doc.get("rules") or []:
        if not isinstance(r, dict):
            continue
        source = r.get("source") or {}
        why, public = "", False
        if not rules_selected:
            why = f"{RULES_FILE} is not selected"
        elif r.get("follows") == "default-licence" or r.get("share") == "never":
            why = "share: never (kept in this installation)"
        elif r.get("project") and not r.get("content") and r.get("follows") == "never-publish":
            why = "it names a project kept private"
        elif r.get("content") and r.get("project") and str(r["project"]) in private_projects():
            why = f"it names {r['project']}, kept private"
        elif f"{EPISODES}{source.get('braindump')}/braindump.md" not in selected:
            why = f"its braindump {source.get('braindump')} is not selected"
        else:
            public, why = True, f"its braindump {source.get('braindump')} is selected"
        out.append({"id": r.get("id"), "share": r.get("share") or "default", "public": public, "why": why})
    return out


def cmd_facts(ctx: Ctx, rev: str, with_runs: bool) -> dict:
    """improve_publish p3: what is public, what is selected, what is local and what is pending, per repository of the
    graph at rev, for the Catalog page. Reads only: no stage, no fetch, no write."""
    journal = ctx.read_journal()
    holds = ctx.read_holds()
    root = discover(ctx, rev)
    out = {"root": root.id, "source_rev": root.rev, "project": project_of(ctx), "problems": validate(ctx, root, journal),
           "repositories": [], "holds": holds, "operation": None}
    op = last_stage(journal)
    if op:
        out["operation"] = {k: op.get(k) for k in ("id", "status", "owner", "scope_answer", "scope_change", "root_rev", "completed_at")}
    for node in postorder(root):
        state = journal["repositories"].get(node.id)
        published = entries(state, "published") if state else []
        last = published[-1] if published else None
        staged = (entries(state, "staged") or [None])[-1] if state else None
        conflict = (entries(state, "conflict") or [None])[-1] if state else None
        answered, basis = answered_scope(node.repo, state, node.contract_path)
        try:
            items, change = scope_compare(node.repo, node.rev, node.contract, answered)
        except Refusal as refusal:
            items, change = [], []
            out["problems"].append(f"{node.id}: {refusal}")
        listing = [r.split("\t", 1)[1] for r in filter(None, git(node.repo, "ls-tree", "-r", "-z", "--full-tree", node.rev).decode().split("\0"))]
        locals_ = local_paths(node.contract)
        widen = {key_of(c): c for c in change}
        last_keys = {key_of(a) for a in (last.get("scope") or []) if isinstance(a, dict)} if last and last.get("scope") is not None else None
        selections = []
        for item in items:
            paths = [f"{RUNS_DIR}/{item['id']}/{n}" for n in item["files"]] if item["kind"] == "run" else \
                [item["path"]] if item["kind"] == "submodule" else item_paths(item, listing, locals_)
            k = key_of(item)
            if k in widen:
                status = "widening"
            elif last is None:
                status = "selected, not published yet"
            elif last_keys is not None and k not in last_keys and item["kind"] != "tree":
                status = "selected, not published yet"
            elif last["source_rev"] == node.rev:
                status = "public"
            else:
                status = "public; source changed since"
            edits = 0
            if item["kind"] == "file":
                edits = next((len(f.get("edit", [])) for f in node.contract.get("file", []) if f.get("public") == item.get("public")), 0)
            selections.append({**{k2: v for k2, v in item.items() if k2 != "answer"}, "key": label_of(item["kind"], item),
                               "group": group_of(item, paths), "status": status, "answer": item.get("answer"),
                               "paths": paths[:50], "count": len(paths), "edits": edits,
                               **({"adds": widen[k]["adds"][:50]} if k in widen else {})})
        local = []
        for e in node.contract.get("local", []):
            p = str(e.get("path", "")).strip("/")
            local.append({"path": p, "because": e.get("because"), "public": public_holds(node.repo, state, node.contract_path, p)})
        # Selections of the last publication no longer selected (narrowed without a [[local]]).
        dropped = []
        if last and last.get("scope"):
            now_keys = {key_of(i) for i in items}
            for a in last["scope"]:
                if key_of(a) not in now_keys:
                    dropped.append({"key": label_of(a["kind"], a), "kind": a["kind"], "answer": a.get("answer"),
                                    "public_commit": last["public_commit"]})
        repo = {"id": node.id, "name": node.name, "path": node.path, "source_rev": node.rev,
                "destination": node.contract.get("destination"), "visibility": node.contract.get("visibility"),
                "license": node.contract.get("license"), "because": node.contract.get("because"),
                "checkout": checkout_of(ctx, root, node, journal).relative_to(ctx.workspace).as_posix(),
                "public": {"public_commit": last["public_commit"], "source_rev": last["source_rev"],
                           "published_at": last.get("published_at"), "scope": last.get("scope"),
                           "scope_recorded": last.get("scope") is not None} if last else None,
                "publications": len(published), "answered_by": basis, "selections": selections, "local": local,
                "dropped": dropped, "staged": {k: staged.get(k) for k in ("operation", "public_commit", "source_rev", "staged_at")} if staged else None,
                "conflict": {"files": conflict["conflict"]["files"], "at": conflict["conflict"]["at"]} if conflict else None,
                "excluded": node.excluded, **grounds(node.contract),
                "holds": [h for h in holds if h.get("repository") == node.id]}
        if is_catalog(node.repo, node.rev):
            repo["rules"] = rule_publicity(node.repo, node.rev, node.contract)
        out["repositories"].append(repo)
    if with_runs:
        try:
            out["runs"] = cmd_runs(ctx, rev)
        except Refusal as refusal:
            out["runs"] = {"problem": str(refusal)}
    return out


def scope_proposal(report_repos: list[dict]) -> dict:
    """The build's scope change as one proposal with stable item keys and a version (a digest of the candidate trees
    and the items): what the page offers for one answer with item-level exclusions."""
    items = [{"key": f"{r['id']} {label_of(c['kind'], c)}", "repository": r["id"], "selection": label_of(c["kind"], c),
              "group": c["group"], "adds": c["adds"], "because": c.get("because")} for r in report_repos for c in r["scope_change"]]
    repos = [{"id": r["id"], "candidate_tree": r["candidate_tree"], "source_rev": r["source_rev"]} for r in report_repos]
    version = hashlib.sha256(json.dumps({"repositories": repos, "items": items}, sort_keys=True).encode()).hexdigest()[:16]
    return {"schema": "agdev.publication.v1.scope-proposal", "version": version, "repositories": repos, "items": items}


# ---------------------------------------------------------------- plan / build / status / convert

def describe(ctx: Ctx, rev: str) -> dict:
    journal = ctx.read_journal()
    root = discover(ctx, rev)
    out = {"root": root.id, "repositories": [], "problems": validate(ctx, root, journal)}
    for node in postorder(root):
        state = journal["repositories"].get(node.id, {})
        last = (entries(state, "published") or [None])[-1] if state else None
        out["repositories"].append({
            "id": node.id, "path": node.path, "source_rev": node.rev, "internal_url": node.url,
            "destination": node.contract["destination"], "visibility": node.contract.get("visibility"),
            "license": node.contract.get("license"), "checkout": checkout_of(ctx, root, node, journal).as_posix(),
            "submodules": [{"path": c.path, "repository": c.id, "source_rev": c.rev} for c in node.children],
            "excluded": node.excluded,
            "last_published": {"source_rev": last["source_rev"], "public_commit": last["public_commit"]} if last else None,
            **grounds(node.contract), "local": [e.get("path") for e in node.contract.get("local", [])],
            "runs": [e.get("id") for e in node.contract.get("run", [])]})
    return out


def cmd_build(ctx: Ctx, rev: str, out: Path, extra_secrets: list[str]) -> dict:
    disclosure_refusal(ctx)
    journal = ctx.read_journal()
    root = discover(ctx, rev)
    report = {"root": root.id, "problems": validate(ctx, root, journal), "repositories": []}
    for node in postorder(root):
        links = {}
        for child in node.children:
            state = journal["repositories"].get(child.id, {})
            match = [p for p in state.get("publications", []) if p["source_rev"] == child.rev and p.get("public_commit")]
            links[child.path] = (match[-1]["public_commit"] if match else "",
                                 public_url(child.contract["destination"], node.contract["destination"]))
        info = build(ctx, node.repo, node.rev, node.contract, out / node.name, links,
                     [s["path"] for s in node.contract.get("submodule", [])])
        kept: list[dict] = []
        findings = check(ctx, out / node.name, node.contract, extra_secrets, kept)
        with tempfile.TemporaryDirectory() as tmp:  # the tree id, for comparison with the journal
            git(Path(tmp), "init", "-q")
            tree = tree_of(Path(tmp), out / node.name, [g for g in info["gitlinks"] if g[1]])
        info["gitlinks"] = [(path, commit or "not yet staged") for path, commit in info["gitlinks"]]
        scope = scope_of(ctx, node, journal)
        report["repositories"].append({"id": node.id, "source_rev": node.rev, "out": (out / node.name).as_posix(),
                                       "candidate_tree": tree, "files": len(info["files"]), "inputs": info["inputs"],
                                       "gitlinks": info["gitlinks"], "findings": findings,
                                       "private_names": {"searched": sorted(private_projects()), "allowed": kept},
                                       "scope_change": scope["change"], "scope_change_lines": change_lines(scope),
                                       "answered_by": scope["answered_by"], "not_grounded": scope["not_grounded"],
                                       "grounds_stale": scope["grounds_stale"], "local": scope["local"]})
        if GROUNDS_REQUIRED and scope["not_grounded"]:
            raise Refusal.coded("contract", f"{node.id} is not grounded: " + "; ".join(scope["not_grounded"]))
        held = held_selection(ctx.read_holds(), node.id, selected_source_paths(node.repo, node.rev, node.contract))
        report["repositories"][-1]["holds"] = [{"path": h["path"], "request": h["request"], "selects": p[:10]} for h, p in held]
    report["scope_proposal"] = scope_proposal(report["repositories"])
    return report


def run_changes(repo: Path, rev: str) -> dict[str, set[str]]:
    """Per run (<workflow>/<run>) the files outside devdocs/runs/ changed by the commits whose message names it."""
    import re
    names = re.compile(r"(?<![A-Za-z0-9_.-])([a-z0-9][a-z0-9_.-]*/run-[0-9]+)(?![0-9A-Za-z])")
    out: dict[str, set[str]] = {}
    log = git(repo, "log", "--no-merges", "--name-only", "--format=%x01%B%x02", rev).decode("utf-8", errors="replace")
    for record in log.split("\x01")[1:]:
        message, _, files = record.partition("\x02")
        changed = {f for f in files.split("\n") if f.strip() and not under(f.strip(), RUNS_DIR)}
        if not changed:
            continue
        for run in set(names.findall(message)):
            out.setdefault(run, set()).update(changed)
    return out


MEDIA = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".mp4", ".webm", ".ogv", ".mov", ".wav", ".flac", ".mp3",
         ".ogg", ".npy", ".npz", ".exr", ".glb", ".gltf", ".fbx", ".blend", ".ctex", ".md5", ".import", ".log", ".zip")
CODE = (".py", ".ts", ".js", ".mjs", ".sh", ".gd", ".gdshader", ".tscn", ".tres", ".toml", ".yaml", ".yml", ".json", ".css",
        ".html", ".rs", ".go", ".c", ".h", ".cpp", ".cfg")


def change_kind(path: str) -> str:
    """What a changed file is, for the publisher's first look: workflow, code, text, media or other."""
    low = path.lower()
    if under(path, WORKFLOWS_DIR):
        return "workflow"
    if "/.godot/" in f"/{low}" or low.endswith(MEDIA):
        return "media"
    if low.endswith(CODE) or "/" in path and Path(path).suffix == "" and not low.endswith(".gitkeep"):
        return "code"
    if low.endswith((".md", ".txt", ".rst")):
        return "text"
    return "other"


def cmd_runs(ctx: Ctx, rev: str) -> dict:
    """improve_publish p2 decision 17: the runs of the project not yet judged, before any reading."""
    project = project_of(ctx)
    rev = git(ctx.source, "rev-parse", "--verify", f"{rev}^{{commit}}").decode().strip()
    contract = load_contract(ctx.source, rev, ctx.contract)
    crit = criterion("runs", project)
    listing = [r.split("\t", 1)[1] for r in filter(None, git(ctx.source, "ls-tree", "-r", "-z", "--full-tree", rev).decode().split("\0"))]
    folders: dict[str, list[str]] = {}
    for path in listing:
        parts = path.split("/")
        if len(parts) >= 5 and under(path, RUNS_DIR):
            folders.setdefault(f"{parts[2]}/{parts[3]}", []).append("/".join(parts[4:]))
    selected = {str(e.get("id", "")).strip("/"): e for e in contract.get("run", [])}
    locals_ = local_paths(contract)
    judged = (contract.get("runs") or {}).get("judged")
    judged_note, judged_ok = "no [runs] judged in the contract", False
    if judged:
        if not git_ok(ctx.source, "cat-file", "-e", f"{judged}^{{commit}}") or not git_ok(ctx.source, "merge-base", "--is-ancestor", judged, rev):
            judged_note = f"[runs] judged = {judged} is not an ancestor of {rev[:12]}: every run is listed"
        else:
            at = git(ctx.source, "show", "-s", "--format=%cI", judged).decode().strip()
            def utc(t: str) -> datetime:
                return datetime.fromisoformat(t.replace("Z", "+00:00")).astimezone(timezone.utc)
            if crit and crit.get("adopted") and crit.get("at") and utc(crit["at"]) > utc(at):
                judged_note = f"{crit['rule']} was adopted after {judged[:12]} ({at}): a new criterion, every run is listed"
            else:
                judged_ok, judged_note = True, f"judged up to {judged[:12]} ({at})"
    changes = run_changes(ctx.source, rev)
    private = [(p, private_name_re(p)) for p in sorted(private_projects())]
    forbidden = [w for w in contract.get("forbidden", [])]
    out = {"project": project, "source_rev": rev, "criterion": crit, "judged": judged_note, "selected": [], "local": [],
           "unchanged_since_judged": 0, "runs": []}

    def number(run: str):
        w, r = run.split("/")
        return (w, int(r.rsplit("-", 1)[-1]) if r.rsplit("-", 1)[-1].isdigit() else 0, r)

    for run in sorted(folders, key=number):
        folder = f"{RUNS_DIR}/{run}"
        if run in selected:
            out["selected"].append({"id": run, "files": selected[run].get("files", RUN_FILES), "because": selected[run].get("because")})
            continue
        if any(under(folder, l) for l in locals_):
            out["local"].append(run)
            continue
        if judged_ok and git_ok(ctx.source, "diff", "--quiet", judged, rev, "--", folder):
            out["unchanged_since_judged"] += 1
            continue
        outside = sorted(changes.get(run, set()))
        kinds: dict[str, int] = {}
        for f in outside:
            k = change_kind(f)
            kinds[k] = kinds.get(k, 0) + 1
        line = {"id": run, "kinds": kinds, "development": [f for f in outside if change_kind(f) in ("workflow", "code", "text")][:40],
                "outside": outside, "texts": sorted(f for f in folders[run] if f.endswith((".md", ".txt")) and "/" not in f)}
        for name in ("request.md", "report.md"):
            if name in folders[run]:
                text = git(ctx.source, "cat-file", "blob", f"{rev}:{folder}/{name}").decode("utf-8", errors="replace")
                line[name] = {"bytes": len(text.encode()), "private": [p for p, rx in private if rx.search(text)],
                              "forbidden": [w for w in forbidden if w.lower() in text.lower()]}
            else:
                line[name] = None
        out["runs"].append(line)
    return out


def cmd_convert(ctx: Ctx) -> dict:
    with ctx.lock():
        if not ctx.journal_path.is_file():
            raise Refusal.coded("usage", "no journal")
        old = json.loads(ctx.journal_path.read_text(encoding="utf-8"))
        if old.get("schema") == JOURNAL_SCHEMA:
            raise Refusal.coded("usage", "already converted")
        if old.get("schema") != "forge.publication.v1.journal":
            raise Refusal.coded("usage", f"unknown journal schema {old.get('schema')}")
        url = git(ctx.source, "remote", "get-url", "origin").decode().strip()
        pubs = old["publications"]
        first = pubs[0]
        keep = ctx.journal_path.with_name("github.forge-v1.json")
        if not keep.exists():
            keep.write_bytes(ctx.journal_path.read_bytes())
        converted = {"schema": JOURNAL_SCHEMA, "converted_from": {"schema": old["schema"], "copy": keep.name, "at": now()},
                     "repositories": {identity(url): {
                         "name": identity(url).rsplit("/", 1)[-1], "internal_url": url,
                         "destination": first["destination"], "branch": first["branch"], "checkout": "published",
                         "contract": ctx.contract,
                         "publications": [{**p, "gitlinks": p.get("gitlinks", [])} for p in pubs]}},
                     "operations": []}
        ctx.write_journal(converted)
        return converted


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--workspace", type=Path, help="project workspace (default: the source checkout's parent)")
    parser.add_argument("--source", type=Path, help="root source checkout (default: <workspace>/source, or the cwd)")
    parser.add_argument("--contract", default=DEFAULT_CONTRACT, help="root contract path inside the source repository")
    parser.add_argument("--secrets", action="append", default=[], help="extra workspace KEY=VALUE file to search for")
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("plan", "build", "stage"):
        sub = commands.add_parser(name)
        sub.add_argument("--rev", default="HEAD")
        if name == "build":
            sub.add_argument("--out", type=Path, required=True)
        if name == "stage":
            sub.add_argument("--message", required=True)
            sub.add_argument("--owner", help="the run (or person) this staging belongs to, e.g. publisher/publish/run-003")
            sub.add_argument("--take-over", metavar="REASON", help="replace another owner's unfinished staging (why)")
            sub.add_argument("--scope-answer", metavar="RUN#QUESTION",
                             help="the answered question that covers this candidate's scope change, e.g. publisher/publish/run-031#q1")
    rr = commands.add_parser("runs")
    rr.add_argument("--rev", default="HEAD")
    ff = commands.add_parser("facts")
    ff.add_argument("--rev", default="HEAD")
    ff.add_argument("--runs", action="store_true", help="include the runs listing (slower on projects with many runs)")
    hh = commands.add_parser("hold")
    hh.add_argument("action", choices=["add", "withdraw", "list"])
    hh.add_argument("--repo")
    hh.add_argument("--path")
    hh.add_argument("--request")
    hh.add_argument("--by")
    hh.add_argument("--note")
    r = commands.add_parser("resolve")
    r.add_argument("--repo", required=True)
    r.add_argument("--note", required=True)
    a = commands.add_parser("abort")
    a.add_argument("--repo", required=True)
    p = commands.add_parser("push")
    p.add_argument("--stop-before", help="repository id: stop at this boundary (resume with push)")
    p.add_argument("--operation", help="the stage operation id you assessed; refused if it is no longer the last one")
    for sub in (r, a, p):
        sub.add_argument("--owner", help="the owner the last staging was made with")
        sub.add_argument("--take-over", metavar="REASON", help="act on another owner's staging (why)")
    commands.add_parser("status")
    commands.add_parser("convert-journal")
    args = parser.parse_args()
    try:
        workspace = args.workspace.resolve() if args.workspace else None
        ctx = Ctx(workspace, args.source, args.contract)
        if args.command == "plan":
            result = describe(ctx, args.rev)
        elif args.command == "build":
            result = cmd_build(ctx, args.rev, args.out.resolve(), args.secrets)
        elif args.command == "stage":
            result = cmd_stage(ctx, args.rev, args.message, args.secrets, args.owner, args.take_over, args.scope_answer)
        elif args.command == "runs":
            result = cmd_runs(ctx, args.rev)
        elif args.command == "facts":
            result = cmd_facts(ctx, args.rev, args.runs)
        elif args.command == "hold":
            result = cmd_hold(ctx, args.action, args.repo, args.path, args.request, args.by, args.note)
        elif args.command == "resolve":
            result = cmd_resolve(ctx, args.repo, args.note, args.secrets, args.owner, args.take_over)
        elif args.command == "abort":
            result = cmd_abort(ctx, args.repo, args.owner, args.take_over)
        elif args.command == "push":
            result = cmd_push(ctx, args.stop_before, args.owner, args.operation, args.take_over)
        elif args.command == "convert-journal":
            result = cmd_convert(ctx)
        else:
            result = ctx.read_journal()
        print(json.dumps(result, indent=2, ensure_ascii=False))
        if args.command == "build" and any(r["findings"] for r in result["repositories"]):
            sys.exit(1)
    except Refusal as refusal:
        print(f"agdev-external-publish [{refusal.code}]: {refusal}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
