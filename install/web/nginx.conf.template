# The agdev origin: /wfe/ is the native workflow editor service, /hangout/ the aghangout
# release from the operating area (mapped read-only), on one origin so its writes are same-origin.
server {
    listen 8080;
    absolute_redirect off;
    # Old Front Desk links (`/?view=frontdesk&conv=<id>`, in Slack threads of an adopted installation)
    # open that conversation in aghangout; every other address goes Home.
    location / {
        if ($arg_view = "frontdesk") { return 302 /hangout/?conv=$arg_conv; }
        return 302 /wfe/;
    }
    location = /hangout { return 302 /hangout/$is_args$args; }
    location /hangout/ {
        # Nothing deployed: the conversation-page role is not filled here (workflow_editor docs/summon.md).
        if (!-f /agdev/hangout/current/index.html) {
            add_header Content-Type "text/plain; charset=utf-8" always;
            return 503 "The conversation page is not deployed here: the conversation-page role is not filled (wfe summon status).\n";
        }
        alias /agdev/hangout/current/;
        index index.html;
        add_header Cache-Control "no-cache";
    }
    location /wfe/ {
        proxy_pass http://agdev-core:${AGDEV_WFE_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header x-wfe-route agdev;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        client_max_body_size 100m;
    }
}
