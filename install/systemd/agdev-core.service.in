# Native core service @SERVICE@ of installation @SLUG@, on the selected release.
# Generated by agdevctl. It needs no login shell: its environment is in the file below.
[Unit]
Description=agdev @SERVICE@ (@SLUG@)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=@USER@
WorkingDirectory=@WORKDIR@
EnvironmentFile=@ENV@
Environment=AGDEV_SERVICE=@SERVICE@
UMask=0002
NoNewPrivileges=yes
ProtectHome=yes
ExecStart=@GATE@ @COMMAND@
Restart=always
RestartSec=10
@EXTRA@

[Install]
WantedBy=multi-user.target
