def wait_http(url: str, seconds: int, what: str, insecure=False) -> None:
    context = ssl._create_unverified_context() if insecure else None
    deadline = time.monotonic() + seconds
    last = ""
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=10, context=context) as response:
                if response.status < 500:
                    return
        except urllib.error.HTTPError as error:
            last = f"HTTP {error.code}"
            if error.code < 500:
                return
        except Exception as error:  # noqa: BLE001 - reported on timeout
            last = str(error)
        time.sleep(5)
    raise SystemExit(f"{what} did not answer at {url} within {seconds}s: {last}")


class StartFailed(RuntimeError):
    """Some services did not start; the others did. `failed` maps each to why."""

    def __init__(self, failed: dict[str, str]):
        self.failed = failed
        super().__init__("not started: " + "; ".join(f"{s} ({why})" for s, why in failed.items()))


def start_native(i: Instance, services: list[str] = NATIVE_SERVICES, restart=False) -> None:
    if not (i.area / "service" / "current").exists():
        raise SystemExit("no release is selected yet: `activate <commit>`")
    failed: dict[str, str] = {}
    for service in services:
        # Enabled, so a boot (or the user's login) restores them; the order is what the monitors expect.
        # One that does not start does not keep the rest from starting (improve_multinodes p1 ex1).
        try:
            svc_start(i, service, restart=restart)
        except (subprocess.CalledProcessError, RuntimeError) as error:
            failed[service] = (f"{' '.join(str(a) for a in error.cmd[:3])} exited {error.returncode}" if isinstance(error, subprocess.CalledProcessError) else str(error))[-300:]
    if failed:
        raise StartFailed(failed)


def stop_native(i: Instance, services: list[str] = NATIVE_SERVICES) -> None:
    # Observer and its watchdog first, so a planned stop raises no incident; WFE last.
    for service in ("watchdog", "observer", "executor", "wfe"):
        if service in services:
            done = svc_stop(i, service)
            if done.returncode != 0:
                raise SystemExit(f"stopping {service} failed: {(done.stderr or done.stdout)[-300:]}")


def cmd_up(i: Instance, args) -> None:
    infra = args.stage in ("infra", "all")
    core = args.stage in ("core", "all")
    if infra:
        if i.infra:
            compose(i, "up", "-d", "--remove-orphans" if args.stage == "all" else "--no-recreate", *i.infra)
        else:
            say("Gitea is an attached service: nothing to start for infra")
    if core:
        compose(i, "up", "-d", "--no-deps", WEB_SERVICE)
        start_native(i)
    say(f"up: {args.stage}")


def cmd_stop(i: Instance, args) -> None:
    named = args.services or NATIVE_SERVICES + [WEB_SERVICE] + i.infra
    refuse_attached(i, named)
    stop_native(i, [s for s in named if s in NATIVE_SERVICES])
    containers = [s for s in named if s not in NATIVE_SERVICES]
    if containers:
        compose(i, "stop", *containers)


def cmd_start(i: Instance, args) -> None:
    named = args.services or i.infra + [WEB_SERVICE] + NATIVE_SERVICES
    refuse_attached(i, named)
    containers = [s for s in named if s not in NATIVE_SERVICES]
    if containers:
        # `up --no-deps` also creates a container that was never made (a successor started only after `adopt`).
        compose(i, "up", "-d", "--no-deps", *containers)
    native = [s for s in NATIVE_SERVICES if s in named]
    if native:
        start_native(i, native)


def refuse_attached(i: Instance, named: list[str]) -> None:
    attached = [s for s in named if s in INFRA_SERVICES and s not in i.infra]
    if attached:
        raise SystemExit(f"{', '.join(attached)}: an attached service, not this installation's; agdevctl never starts or stops it")


def account_exists(name: str) -> bool:
    try:
        pwd.getpwnam(name)
        return True
    except KeyError:
        return False


def inventory(i: Instance) -> dict:
    label = f"label=com.docker.compose.project={i.project}"
    q = lambda *c: run(["docker", *c], capture=True, check=False).stdout.split()  # noqa: E731
    return {
        "containers": q("ps", "-a", "--filter", label, "--format", "{{.Names}}"),
        "networks": q("network", "ls", "--filter", label, "--format", "{{.Name}}"),
        "volumes": q("volume", "ls", "--filter", label, "--format", "{{.Name}}"),
        "units": svc_installed(i),
        "paths": [str(i.root)] + ([str(i.projects_root)] if not str(i.projects_root).startswith(str(i.root) + "/") else []),
        "attached": {"gitea": i.gitea_url} if i.gitea_external else {},
        # Prepared with the host and kept by a removal unless --purge-accounts asks otherwise.
        "accounts": {a: pwd.getpwnam(a).pw_dir for a in {i.core_account, i.monitor_account, i.build_account} if account_exists(a)},
        "tools": i.tools,
    }


def status_facts(i: Instance) -> dict:
    result = {"instance": i.id if (i.config / "instance-id").exists() else None, "root": str(i.root), "urls": {"gitea": i.gitea_url, "web": i.web_url}}
    try:
        tool = alert_tool(i)
        result["alerts"] = tool.status(alerts_file(i)) if tool else {"configured": False, "tool": "not installed"}
    except Exception as error:  # noqa: BLE001 - shown, not fatal
        result["alerts"] = {"error": str(error)[:300]}
    out = run(["docker", "ps", "-a", "--filter", f"label=com.docker.compose.project={i.project}", "--format", "{{.Label \"com.docker.compose.service\"}}\t{{.State}}\t{{.Status}}"], capture=True, check=False).stdout
    result["containers"] = {line.split("\t")[0]: line.split("\t")[2] for line in out.splitlines() if line}
    result["services"] = {s: svc_state(i, s) for s in NATIVE_SERVICES}
    result["lifecycle"] = svc_state(i, "lifecycle")
    result["manager"] = i.manager
    result["attached"] = {"gitea": i.gitea_url} if i.gitea_external else {}
    result["projects"] = str(i.projects_root)
    clock = {}
    for path in sorted((i.lifecycle / "status").glob("clock-*.json")):
        clock[path.stem[6:]] = read_json(path)
    result["clock"] = clock
    result["hostClockSynchronized"] = host_clock_synchronized(i)
    current = i.area / "service" / "current"
    if current.exists():
        result["release"] = read_json(current / "RELEASE.json")
    drain = i.area / ".local" / "exec" / "drain"
    result["draining"] = drain.exists()
    updates = sorted((i.lifecycle / "updates").glob("*.json"), key=lambda p: p.stat().st_mtime)
    result["lastUpdate"] = read_json(updates[-1]) if updates else None
    result["source"] = i.source_url
    return result


def cmd_status(i: Instance, args) -> None:
    print(json.dumps(status_facts(i), indent=1, ensure_ascii=False))


def cmd_inventory(i: Instance, args) -> None:
    print(json.dumps(inventory(i), indent=1))


def cmd_remove(i: Instance, args) -> None:
    instance = i.id    # read once: the id lives in config/, which this command deletes
    if args.confirm_instance != instance:
        raise SystemExit(f"removal needs --confirm-instance {instance} (this installation); nothing was changed")
    held = inventory(i)
    evidence = Path(args.keep_evidence).expanduser() if args.keep_evidence else None
    if evidence:
        evidence.mkdir(parents=True, exist_ok=True)
        write_json(evidence / f"removed-{instance}.json", {"at": now(), "instance": instance, "inventory": held})
    svc_remove(i)
    # Only this installation's Compose project: an attached Gitea is not part of it and stays untouched.
    compose(i, "down", "--volumes", "--remove-orphans", "--timeout", "30")
    # Only this installation's folders are named. Dependency images stay: they are shared and pinned.
    for child in ("config", "data", "logs"):
        shutil.rmtree(i.root / child, ignore_errors=False)
    if args.purge_accounts and not unprivileged():
        for account, home in held["accounts"].items():
            run(["userdel", account])
            shutil.rmtree(home, ignore_errors=True)
    say(f"removed instance {instance}: {json.dumps(held)}; kept {i.bundles}" + ("" if args.purge_accounts else " and the accounts with their homes (model login, caches)"))


# ---- Gitea

def api(url: str, *, method="GET", token=None, basic=None, body=None, form=None, insecure=False, ok=(200, 201, 204)):
    data = None
    headers = {}
    if token:
        headers["Authorization"] = f"token {token}"
    if basic:
        headers["Authorization"] = "Basic " + base64.b64encode(f"{basic[0]}:{basic[1]}".encode()).decode()
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    if form is not None:
        data = urllib.parse.urlencode(form).encode()
    request = urllib.request.Request(url, data=data, method=method, headers=headers)
    context = ssl._create_unverified_context() if insecure else None
    try:
        with urllib.request.urlopen(request, context=context, timeout=60) as response:
            raw = response.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as error:
        if error.code in ok:
            return {}
        raise RuntimeError(f"{method} {url}: HTTP {error.code}: {error.read().decode(errors='replace')[:400]}") from None


def gitea_token(i: Instance) -> str:
    return i.secret("gitea_owner_token")


def attach_gitea(i: Instance) -> None:
    """An existing Gitea: check that the given token acts as the given owner, and keep a copy of it. Nothing is created."""
    token_file = Path(i.gitea_cfg.get("token_file", ""))
    if not token_file.is_file():
        raise SystemExit(f"[gitea] token_file {token_file} is not a file; nothing was changed")
    token = token_file.read_text().strip()
    wait_http(f"{i.gitea_url}/api/healthz", 60, "Gitea")
    login = api(f"{i.gitea_url}/api/v1/user", token=token)["login"]
    if login != i.gitea_owner:
        raise SystemExit(f"the token in {token_file} acts as {login!r}, not the owner {i.gitea_owner!r}; nothing was changed")
    i.put_secret("gitea_owner_token", token)
    i.mark("gitea-attached")
    say(f"Gitea {i.gitea_url} attached as {login}; its accounts, repositories and settings are left as they are")


def cmd_provision_gitea(i: Instance, args) -> None:
    if i.gitea_external:
        return attach_gitea(i)
    wait_http(f"{i.gitea_url}/api/healthz", 180, "Gitea")
    name = i.owner["name"]
    password = i.secret("gitea_owner_password")
    if not i.done("gitea-owner"):
        probe = compose(i, "exec", "-T", "-u", "git", "gitea", "gitea", "admin", "user", "list", capture=True).stdout
        if name not in probe.split():
            created = subprocess.run(["docker", "compose", "--project-directory", str(compose_dir(i)), "-f", str(compose_dir(i) / "compose.yaml"),
                                      "--env-file", str(compose_env_path(i)), "--profile", "all", "exec", "-T", "-u", "git", "gitea", "gitea", "admin", "user", "create",
                                      "--admin", "--username", name, "--email", i.owner["email"], "--password", password, "--must-change-password=false"],
                                     env={**os.environ, **read_env(compose_env_path(i))}, capture_output=True, text=True)
            if created.returncode != 0:
                raise SystemExit("creating the Gitea owner failed: " + created.stderr.replace(password, "<password>")[-400:])
        i.mark("gitea-owner")
    if not (i.secrets / "gitea_owner_token").exists():
        token = api(f"{i.gitea_url}/api/v1/users/{name}/tokens", method="POST", basic=(name, password),
                    body={"name": f"agdev-{i.id}-{secrets.token_hex(3)}", "scopes": ["all"]})
        i.put_secret("gitea_owner_token", token["sha1"])
    say(f"Gitea owner {name}: {api(f'{i.gitea_url}/api/v1/user', token=gitea_token(i))['login']} verified")


