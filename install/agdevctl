def manifest(i: Instance) -> list[dict]:
    return read_json(i.bundles / "manifest.json", {"sources": []})["sources"]


def git_auth(i: Instance) -> list[str]:
    return ["-c", f"http.extraHeader=Authorization: token {gitea_token(i)}"]


def cmd_import_sources(i: Instance, args) -> None:
    """Create each manifest source on this installation's Gitea and push its bundle."""
    owner = i.gitea_owner
    token = gitea_token(i)
    if i.gitea_external:
        # An attached Gitea is someone else's: report what is there, never create or push.
        missing = [s["repository"] for s in manifest(i) if not (s.get("project") == CORE_PROJECT and i.source_external)
                   and not api(f"{i.gitea_url}/api/v1/repos/{owner}/{s['repository']}", token=token, ok=(200, 404))]
        say(f"Gitea {i.gitea_url} is attached, not this installation's: nothing imported" + (f"; missing there: {', '.join(missing)}" if missing else ""))
        return
    for source in manifest(i):
        name = source["repository"]
        if source.get("project") == CORE_PROJECT and i.source_external:
            say(f"{name}: the core's source is {i.source_url}; this Gitea holds no copy of it")
            continue
        url = f"{i.gitea_url}/api/v1/repos/{owner}/{name}"
        if not api(url, token=token, ok=(200, 404)):
            api(f"{i.gitea_url}/api/v1/user/repos", method="POST", token=token, body={"name": name, "private": False, "default_branch": "main", "description": source.get("description", "")})
        bundle = i.bundles / source["bundle"]
        with tempfile.TemporaryDirectory() as tmp:
            run(["git", "clone", "-q", "--bare", str(bundle), tmp + "/r"])
            head = run(["git", "-C", tmp + "/r", "rev-parse", "refs/heads/main"], capture=True).stdout.strip()
            if head != source["commit"]:
                raise SystemExit(f"{source['bundle']}: main is {head}, the manifest says {source['commit']}")
            remote = f"{i.gitea_url}/{owner}/{name}.git"
            existing = run(["git", *git_auth(i), "ls-remote", remote, "refs/heads/main"], capture=True).stdout.split()
            if existing and existing[0] != head:
                say(f"{name}: Gitea main is {existing[0][:12]}, newer than the bundle or diverged; left as it is")
            else:
                run(["git", *git_auth(i), "-C", tmp + "/r", "push", "-q", remote, "refs/heads/main:refs/heads/main"])
                say(f"{name}: main at {head[:12]}")


def cmd_export_sources(i: Instance, args) -> None:
    """Bundle Gitea's current main of every manifest source: what a later recreation starts from."""
    sources = manifest(i)
    for source in sources:
        if source.get("project") == CORE_PROJECT and i.source_external:
            continue
        remote = f"{i.gitea_url}/{i.gitea_owner}/{source['repository']}.git"
        with tempfile.TemporaryDirectory() as tmp:
            run(["git", *git_auth(i), "clone", "-q", "--bare", remote, tmp + "/r"])
            head = run(["git", "-C", tmp + "/r", "rev-parse", "refs/heads/main"], capture=True).stdout.strip()
            run(["git", "-C", tmp + "/r", "bundle", "create", "-q", str(i.bundles / source["bundle"]), "refs/heads/main"])
            source["commit"] = head
        say(f"{source['repository']}: bundled {head[:12]}")
    write_json(i.bundles / "manifest.json", {"sources": sources})


def source_auth(i: Instance) -> list[str]:
    if i.source_token_file:
        return ["-c", f"http.extraHeader=Authorization: token {Path(i.source_token_file).read_text().strip()}"]
    return [] if i.source_external else git_auth(i)


def source_mirror(i: Instance) -> Path:
    """A bare mirror of every branch of the core's source, candidate branches included; fetched on each use."""
    mirror = i.sources / "core.git"
    if not mirror.exists():
        mirror.parent.mkdir(parents=True, exist_ok=True)
        run(["git", *source_auth(i), "clone", "-q", "--bare", i.source_url, str(mirror)])
    run(["git", *source_auth(i), "-C", str(mirror), "fetch", "-q", "--prune", i.source_url, "+refs/heads/*:refs/heads/*"])
    return mirror


# ---- releases

def exported(mirror: Path, commit: str, into: str, *paths: str) -> None:
    archive = subprocess.Popen(["git", "-C", str(mirror), "archive", commit, *paths], stdout=subprocess.PIPE)
    subprocess.run(["tar", "-x", "-C", into], stdin=archive.stdout, check=True)
    if archive.wait() != 0:
        raise RuntimeError(f"cannot read {paths} at {commit}")


def runtime_facts(i: Instance) -> str:
    """The tools a release is built and run with, recorded in RELEASE.json."""
    def version(*cmd: str) -> str:
        return run(list(cmd), capture=True, check=False).stdout.strip().splitlines()[0:1] or ["unknown"]
    facts = {"node": version(f"{i.tools['node']}/node", "--version")[0], "uv": version(f"{i.tools['uv']}/uv", "--version")[0], "claude": version(f"{i.tools['claude']}/claude", "--version")[0],
             "python": version("python3", "--version")[0], "git": version("git", "--version")[0]}
    return " ".join(f"{k}={v.replace(' ', '_')}" for k, v in facts.items())


def safe_source(url: str) -> str:
    """The source URL as a person's browser may see it: http(s) without credentials, else nothing."""
    from urllib.parse import urlsplit
    p = urlsplit(url)
    return url if p.scheme in ("http", "https") and not p.username and not p.password else ""


def release_tool(i: Instance, mirror: Path, *args: str, script: Path) -> None:
    """Run the commit's own release script under the build account, at low priority: monitoring comes first."""
    run_as(i, i.build_account, ["nice", "-n", "10", "sh", str(script), *args], cwd=str(i.area), service=False, umask=0o022, WFE_RELEASE_REPO=str(mirror), WFE_RELEASE_STATE=str(i.state), AGDEV_RUNTIME=runtime_facts(i), AGDEV_SOURCE=safe_source(i.source_url),
           AGDEV_CLOCK_GATE="0", WFE_SERVICE_URL=f"http://127.0.0.1:{i.wfe_port}")


def release_script(i: Instance, mirror: Path, sha: str) -> Path:
    script = i.lifecycle / "release-script.sh"
    script.write_text(run(["git", "-C", str(mirror), "show", f"{sha}:scripts/wfe-release.sh"], capture=True).stdout)
    os.chmod(script, 0o644)
    return script


def build_release(i: Instance, commit: str) -> tuple[str, Path]:
    mirror = source_mirror(i)
    sha = run(["git", "-C", str(mirror), "rev-parse", "--verify", f"{commit}^{{commit}}"], capture=True).stdout.strip()
    release_tool(i, mirror, "build", str(i.area), sha, script=release_script(i, mirror, sha))
    return sha, mirror


def cmd_release_build(i: Instance, args) -> None:
    sha, _ = build_release(i, args.commit)
    say(f"built release {sha}")


def select_release(i: Instance, sha: str, mirror: Path) -> None:
    release_tool(i, mirror, "switch", str(i.area), sha, script=release_script(i, mirror, sha))
    with tempfile.TemporaryDirectory() as tmp:
        exported(mirror, sha, tmp, "install")
        install_compose_resources(i, Path(tmp) / "install")
        # The lifecycle tool and units are copies outside the replaceable runtime.
        install_resources(i, Path(tmp) / "install")
    write_compose_env(i)
    write_units(i, i.installed)


def cmd_activate(i: Instance, args) -> None:
    """First activation, or one by hand: no attempt may be open (an update goes through `supervise`)."""
    busy = open_attempts(i)
    if busy:
        raise SystemExit(f"open attempts: {busy}; use a lifecycle request, which waits for them")
    sha, mirror = build_release(i, args.commit)
    stop_native(i)
    select_release(i, sha, mirror)
    if getattr(args, "no_start", False):
        # A successor that adopts an existing installation's state starts only after `adopt` (docs/migration.md).
        say(f"selected {sha}; nothing started")
        return
    start_native(i, restart=True)
    compose(i, "up", "-d", "--no-deps", "--force-recreate", WEB_SERVICE)
    say(f"activated {sha}: {json.dumps(check_health(i, sha, 300))}")


def sqlite_rows(db: Path, query: str) -> list[str]:
    if not db.exists():
        return []
    code = "import sqlite3,sys\nc=sqlite3.connect(f'file:{sys.argv[1]}?mode=ro',uri=True,timeout=10)\nprint('\\n'.join(str(r[0]) for r in c.execute(sys.argv[2])))"
    done = run([sys.executable, "-c", code, str(db), query], capture=True, check=False)
    if done.returncode != 0:
        raise RuntimeError(f"cannot read {db}: {done.stderr[-300:]}")
    return [line for line in done.stdout.splitlines() if line]


def open_attempts(i: Instance) -> list[str]:
    return sqlite_rows(i.area / ".local" / "exec" / "exec.sqlite",
                       "SELECT id || ' (' || workspace || ' ' || workflow || '/' || run || ')' FROM attempts WHERE state != 'ended'")


def check_health(i: Instance, sha: str, seconds: int) -> dict:
    """The actual API, CLI, executor heartbeat and Observer's own health, all on `sha`."""
    deadline = time.monotonic() + seconds
    facts: dict = {}
    while time.monotonic() < deadline:
        facts = {}
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{i.ports['web']}/wfe/api/version", timeout=10) as response:
                version = json.load(response)
            facts["api"] = version.get("release", {}).get("agdevworld")
            facts["instance"] = version.get("instance")
        except Exception as error:  # noqa: BLE001 - a fact of this look
            facts["api"] = f"unavailable: {error}"
        cli = run_as(i, i.core_account, [str(i.area / "bin" / "wfe"), "version", "--json"], capture=True, check=False)
        try:
            facts["cli"] = json.loads(cli.stdout).get("release", {}).get("agdevworld")
        except ValueError:
            facts["cli"] = f"unavailable: {cli.stderr[-200:]}"
        # As Observer itself reads it: its account, through the group.
        observed = run_as(i, i.monitor_account, [str(i.area / "bin" / "wfe"), "observe", "--json"], capture=True, check=False)
        try:
            age = json.loads(observed.stdout)["executor"]["ageSeconds"]
            facts["heartbeatAge"] = age
        except (ValueError, KeyError):
            facts["heartbeatAge"] = None
        health = read_json(i.state / "agobserver" / "workflow-health.json", {}) or {}
        facts["observer"] = {"source": (health.get("source") or {}).get("state"), "release": (health.get("source") or {}).get("release"), "age": round(time.time() - health.get("written_at", 0), 1)}
        runs = {name: svc_active(i, name) for name in NATIVE_SERVICES}
        runs[WEB_SERVICE] = compose(i, "ps", "--status", "running", "-q", WEB_SERVICE, capture=True, check=False).stdout.strip() != ""
        facts["running"] = runs
        if facts["api"] == sha and facts["cli"] == sha and facts["instance"] == i.id and all(runs.values()) \
                and facts["heartbeatAge"] is not None and facts["heartbeatAge"] < 120 \
                and facts["observer"]["release"] == sha and facts["observer"]["age"] < 120:
            facts["healthy"] = True
            return facts
        time.sleep(5)
    facts["healthy"] = False
    return facts



# ---- the operating area

def write_if_absent(path: Path, value) -> None:
    if not path.exists():
        write_json(path, value)


def browser_url(where: str, value) -> str:
    """A destination for a person's browser, checked as WFE checks it (workflow_editor/server/site.ts)."""
    parts = urllib.parse.urlsplit(value) if isinstance(value, str) else None
    if not parts or parts.scheme not in ("http", "https") or not parts.hostname or parts.username or parts.password:
        raise SystemExit(f"[display] {where}: an http(s) URL without credentials is required, got {value!r}; nothing was changed")
    if parts.hostname in ("localhost", "0.0.0.0", "::1") or parts.hostname.startswith("127."):
        raise SystemExit(f"[display] {where}: {value!r} names the loopback, which other machines cannot follow; nothing was changed")
    return value


def site_settings(i: Instance) -> dict | None:
    """area/site.json from the inputs' [display]; None when the inputs have no such section."""
    display = i.c.get("display")
    if display is None:
        return None
    name = display.get("name")
    if not isinstance(name, str) or not name.strip() or len(name.strip()) > 64:
        raise SystemExit("[display] name: text of at most 64 characters is required; nothing was changed")
    site = {"name": name.strip()}
    parent = display.get("parent")
    if parent is not None:
        if not isinstance(parent.get("name"), str) or not parent["name"].strip():
            raise SystemExit("[display.parent] name is required; nothing was changed")
        site["parent"] = {"name": parent["name"].strip(), "url": browser_url("parent.url", parent.get("url"))}
    links = display.get("boast_links")
    if links:
        site["boastLinks"] = {project: {key: browser_url(f"boast_links.{project}.{key}", url) for key, url in keys.items()} for project, keys in links.items()}
    return site


def write_site(i: Instance) -> bool:
    site = site_settings(i)
    if site is None:
        return False
    write_json(i.area / "site.json", site)
    own(i.area / "site.json", i.core_account)
    return True


def write_placement(i: Instance) -> None:
    """WFE's <area>/placement.json (workflow_editor/docs/placement.md): where workspaces are created and obtained."""
    write_json(i.area / "placement.json", {"projectRoot": str(i.projects_root)})
    own(i.area / "placement.json", i.core_account)


def cmd_placement(i: Instance, args) -> None:
    """Apply [projects] root: new and obtained workspaces go there. Existing ones stay until relocated."""
    ensure_projects_root(i)
    write_placement(i)
    say(f"project root {i.projects_root}; move existing workspaces with `wfe workspace relocate --all` (preview first)")


def cmd_display(i: Instance, args) -> None:
