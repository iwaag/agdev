HERE = Path(__file__).resolve().parent
CORE_PROJECT = "agdev"
NATIVE_SERVICES = ["wfe", "executor", "observer", "watchdog"]
WEB_SERVICE = "web"
GITEA_SERVICES = ["gitea"]
INFRA_SERVICES = GITEA_SERVICES
DARWIN = sys.platform == "darwin"


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def say(message: str) -> None:
    print(f"[{now()}] {message}", flush=True)


class Instance:
    def __init__(self, config: Path):
        self.config_path = config.resolve()   # generated units and agents name it from anywhere (seen: a relative --config, p4)
        self.c = tomllib.loads(config.read_text())
        self.slug = self.c["slug"]
        self.root = Path(self.c["root"])
        self.host = self.c["public_host"]
        self.ports = self.c["ports"]
        self.owner = self.c["owner"]
        self.config = self.root / "config"
        self.secrets = self.config / "secrets"
        self.data = self.root / "data"
        self.area = self.data / "area"
        self.state = self.data / "state"
        self.lifecycle = self.data / "lifecycle"
        self.logs = self.root / "logs"
        self.bundles = self.root / "bundles"
        self.journal = self.config / "init-journal.json"
        # Gitea: this installation's own container, or an existing service it attaches to.
        # An attached service is never provisioned, imported into, stopped or removed by agdevctl.
        deps = self.c.get("dependencies", {})
        self.gitea_external = deps.get("gitea", "owned") == "external"
        if deps.get("zulip", "none") != "none" or "zulip" in self.c:
            # cluster_teamwork p5 retired Zulip; an archived realm is run, if ever, from its retained definitions.
            raise SystemExit('this agdev uses no Zulip: remove [zulip] and set [dependencies] zulip = "none" (or drop it)')
        self.gitea_cfg = self.c.get("gitea", {})
        self.gitea_owner = self.gitea_cfg.get("owner") or self.owner["name"]
        self.gitea_url = (self.gitea_cfg["url"].rstrip("/") if self.gitea_external else f"http://{self.host}:{self.ports['gitea']}")
        self.infra = [] if self.gitea_external else GITEA_SERVICES
        # The owner's alerts, independent of WFE (runtime/agdev_alert.py): route, token_file, channel.
        self.alerts_cfg = self.c.get("alerts", {})
        self.web_url = f"http://{self.host}:{self.ports['web']}"
        self.project = f"agdev-{self.slug}"
        # Where workspaces are created and obtained (WFE's <area>/placement.json); default <root>/projects.
        self.projects_root = Path(self.c.get("projects", {}).get("root") or self.root / "projects")
        # The service manager: systemd units (Linux, root) or the user's LaunchAgents (macOS).
        self.manager = self.c.get("service_manager") or ("launchd" if DARWIN else "systemd")
        self.sources = self.data / "sources"
        accounts = self.c.get("accounts", {})
        self.core_account = accounts.get("core", "agdev-exec")      # WFE, the executor and its agents: they share the stores
        self.monitor_account = accounts.get("monitor", "agdev-svc")  # Observer and its watchdog
        self.build_account = accounts.get("build", "agdev-build")    # builds and owns the releases; no Docker, no secrets
        self.account_homes = accounts.get("home_root", "/var/lib/agdev")
        self.tools = self.c["tools"]                                 # bin folders of the pinned node, uv and claude
        self.wfe_port = self.ports.get("wfe", 8098)
        self.installed = self.config / "install"
        # Where the core's source comes from: this installation's own Gitea unless [source] names another
        # (a candidate runtime builds from its development host's repository and holds no fork of it).
        source = self.c.get("source", {})
        self.source_external = bool(source.get("url"))
        self.source_url = source.get("url") or f"{self.gitea_url}/{self.gitea_owner}/{CORE_PROJECT}.git"
        self.source_token_file = source.get("token_file")              # a path on this host; none: anonymous read
        self.targets = self.c.get("targets", {})                       # installations this one deploys to (agdev-remote)
        self.remote = self.c.get("remote", {})                         # who may operate this one from another installation
        # Updates asked by the operational parent over the agdev link (improve_multinodes p3, docs/management.md):
        # the branch a peer request must be on, and whether peer requests are taken at all. Local policy only.
        self.management = self.c.get("management", {})

    @property
    def id(self) -> str:
        return (self.config / "instance-id").read_text().strip()

    def secret(self, name: str) -> str:
        return (self.secrets / name).read_text().strip()

    def put_secret(self, name: str, value: str) -> None:
        write_private(self.secrets / name, value + "\n")

    def done(self, step: str) -> bool:
        return step in read_json(self.journal, {})

    def mark(self, step: str) -> None:
        journal = read_json(self.journal, {})
        journal[step] = now()
        write_json(self.journal, journal)
        say(f"step done: {step}")


def read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default


def write_json(path: Path, value) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(value, indent=1) + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def write_private(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as out:
        out.write(text)
    os.replace(tmp, path)


def run(cmd: list[str], *, check=True, capture=False, env=None, cwd=None, input_text=None) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=check, text=True, env=env, cwd=cwd, input=input_text,
                          stdout=subprocess.PIPE if capture else None, stderr=subprocess.PIPE if capture else None)


def account_id(name: str) -> tuple[int, int]:
    entry = pwd.getpwnam(name)
    return entry.pw_uid, entry.pw_gid


def me() -> str:
    return pwd.getpwuid(os.getuid()).pw_name


def unprivileged() -> bool:
    """macOS: one user owns every service of the installation (its LaunchAgents); nothing changes owner."""
    return os.geteuid() != 0


def same_account(account: str, what: str) -> None:
    if account not in (me(), "root"):
        raise SystemExit(f"{what} needs account {account}, but agdevctl runs as {me()} without privileges; on macOS every account of [accounts] is the installing user (docs/install.md)")


def own(path: Path, account: str, mode: int | None = None, group: str | None = None) -> None:
    if unprivileged():
        same_account(account, str(path))
    else:
        uid, gid = account_id(account)
        os.chown(path, uid, grp.getgrnam(group).gr_gid if group else gid)
    if mode is not None:
        os.chmod(path, mode)


def tool_path(i: Instance) -> str:
    python = [i.tools["python"]] if i.tools.get("python") else []   # a Python 3.11+ first where the system one is older (macOS)
    return ":".join([str(i.area / "bin"), *python, i.tools["node"], i.tools["uv"], i.tools["claude"], "/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin"])


def python_bin(i: Instance) -> str:
    return f"{i.tools['python']}/python3" if i.tools.get("python") else sys.executable


def account_env(i: Instance, account: str, **extra) -> dict[str, str]:
    """What any process of a service account needs, independent of any login shell."""
    return {"HOME": pwd.getpwnam(account).pw_dir, "USER": account, "LOGNAME": account, "PATH": tool_path(i), "LANG": "en_US.UTF-8" if DARWIN else "C.UTF-8",
            "TZ": i.c.get("execution", {}).get("timezone", "UTC"), "AGDEV_INSTANCE_ID": i.id, "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "safe.directory", "GIT_CONFIG_VALUE_0": "*",
            "DISABLE_AUTOUPDATER": "1", **extra}


def service_env(i: Instance, account: str, **extra) -> dict[str, str]:
    """A process that acts on this installation's area. A release build never gets these: it must not find the real area."""
    # WFE_LOCK_DIR: an installation's locks are its own, even beside another installation of the same account.
    return account_env(i, account, WFE_REGISTRY=str(i.area / "registry.json"), WFE_PORT=str(i.wfe_port), AGDEV_LIFECYCLE=str(i.lifecycle), AGDEV_STATUS_DIR=str(i.lifecycle / "status"),
                       AGDEV_TARGETS=str(i.config / "targets.json"), WFE_LOCK_DIR=str(i.state / "locks"), **extra)


def run_as(i: Instance, account: str, cmd: list[str], *, check=True, capture=False, cwd=None, service=True, umask=0o002, **extra) -> subprocess.CompletedProcess:
    env = (service_env if service else account_env)(i, account, **extra)
    pipes = {"stdin": subprocess.DEVNULL, "stdout": subprocess.PIPE if capture else None, "stderr": subprocess.PIPE if capture else None}
    if unprivileged():
        same_account(account, " ".join(cmd[:2]))
        return subprocess.run(cmd, check=check, text=True, cwd=cwd, env=env, umask=umask, **pipes)
    uid, gid = account_id(account)
    return subprocess.run(cmd, check=check, text=True, cwd=cwd, env=env, user=uid, group=gid, extra_groups=os.getgrouplist(account, gid), umask=umask, **pipes)


# ---- the service manager: systemd units (Linux, root) or the user's LaunchAgents (macOS)

def unit_name(i: Instance, service: str) -> str:
    return f"agdev-{i.slug}-{service}.service"


def lifecycle_unit(i: Instance) -> str:
    return f"agdev-lifecycle-{i.slug}.service"


def systemctl(*args: str, check=True, capture=False) -> subprocess.CompletedProcess:
    return run(["systemctl", *args], check=check, capture=capture)


def label(i: Instance, service: str) -> str:
    """The LaunchAgent label of a native service or of the lifecycle service ("lifecycle")."""
    return f"com.agdev.{i.slug}.{service}"


def agents_dir() -> Path:
    return Path(pwd.getpwuid(os.getuid()).pw_dir) / "Library" / "LaunchAgents"


def plist_path(i: Instance, service: str) -> Path:
    return agents_dir() / f"{label(i, service)}.plist"


def launchctl(*args: str, check=True, capture=True) -> subprocess.CompletedProcess:
    return run(["launchctl", *args], check=check, capture=capture)


def gui(i: Instance, service: str | None = None) -> str:
    return f"gui/{os.getuid()}" + (f"/{label(i, service)}" if service else "")


def launchd_state(i: Instance, service: str) -> dict:
    """What launchd says of one service: loaded, state, pid, runs, last exit."""
    out = launchctl("print", gui(i, service), check=False)
    if out.returncode != 0:
        return {"loaded": False, "installed": plist_path(i, service).exists()}
    facts = {"loaded": True, "installed": plist_path(i, service).exists()}
    for line in out.stdout.splitlines():
        key, found, value = line.strip().partition(" = ")
        name = key.replace(" ", "_")
        if found and key in ("state", "pid", "runs", "last exit code") and name not in facts:   # the service's own, printed first
            facts[name] = value.strip()
    return facts


def service_names(i: Instance) -> list[str]:
    return NATIVE_SERVICES + ["lifecycle"]


def svc_installed(i: Instance) -> list[str]:
    """This installation's generated unit or agent files."""
    if i.manager == "launchd":
        return [str(plist_path(i, s)) for s in service_names(i) if plist_path(i, s).exists()]
    units = [unit_name(i, s) for s in NATIVE_SERVICES] + [lifecycle_unit(i)]
    return [u for u in units if Path("/etc/systemd/system", u).exists()]


# launchctl's answer while an agent is still being torn down (errno EALREADY).
LAUNCHD_IN_PROGRESS = 37
UNLOAD_SECONDS = 60


def wait_unloaded(i: Instance, service: str, seconds: float = UNLOAD_SECONDS) -> bool:
    """launchctl bootout returns before the agent is gone (improve_multinodes p1 ex1): wait until launchd no
    longer knows it. False when it is still there after `seconds`."""
    end = time.monotonic() + seconds
    while launchd_state(i, service)["loaded"]:
        if time.monotonic() > end:
            return False
        time.sleep(0.2)
    return True


def svc_start(i: Instance, service: str, restart=False) -> None:
    """Start (and enable at boot or login) a native service or the lifecycle service."""
    if i.manager == "launchd":
        launchctl("enable", gui(i, service), check=False)
        loaded_file = i.config / "agents-loaded.json"
        loaded = read_json(loaded_file, {}) or {}
        digest = hashlib.sha256(plist_path(i, service).read_bytes()).hexdigest()
        if launchd_state(i, service)["loaded"] and loaded.get(service) != digest:
            # launchd keeps the definition it loaded; a rewritten agent (new environment, paths) is loaded again.
            launchctl("bootout", gui(i, service), check=False)
            wait_unloaded(i, service, 10)
        if launchd_state(i, service)["loaded"]:
            done = launchctl("kickstart", *(["-k"] if restart else []), gui(i, service), check=False)
            if done.returncode == LAUNCHD_IN_PROGRESS:
                # Still being torn down by an earlier bootout (A's update 20261107T092356Z-06f5fc: Observer and
                # watchdog stayed unloaded): wait for it to be gone, then load it again.
                if not wait_unloaded(i, service):
                    raise RuntimeError(f"{label(i, service)} was still being unloaded after {UNLOAD_SECONDS}s; it is not started")
            elif done.returncode != 0:
                raise subprocess.CalledProcessError(done.returncode, done.args, done.stdout, done.stderr)
        if not launchd_state(i, service)["loaded"]:
            launchctl("bootstrap", gui(i), str(plist_path(i, service)))   # RunAtLoad starts it
        loaded[service] = digest
        write_json(loaded_file, loaded)
        return
    unit = lifecycle_unit(i) if service == "lifecycle" else unit_name(i, service)
    systemctl("enable", "-q", unit)
    systemctl("restart" if restart else "start", unit)


def svc_stop(i: Instance, service: str) -> subprocess.CompletedProcess:
    if i.manager == "launchd":
        # Unloaded until started again; its plist stays, so the next login starts it, as a boot starts an enabled unit.
        if not launchd_state(i, service)["loaded"]:
            return subprocess.CompletedProcess([], 0, "", "")
        done = launchctl("bootout", gui(i, service), check=False)
        # bootout returns before the agent is gone; a start right after it would find it "loaded" and be refused
        # (EALREADY). A stop is done when launchd no longer knows the agent (improve_multinodes p1 ex1).
        if done.returncode == 0 and not wait_unloaded(i, service):
            return subprocess.CompletedProcess(done.args, 1, "", f"{label(i, service)} was still being unloaded after {UNLOAD_SECONDS}s")
        return done
    return systemctl("stop", lifecycle_unit(i) if service == "lifecycle" else unit_name(i, service), check=False, capture=True)


def svc_active(i: Instance, service: str) -> bool:
    if i.manager == "launchd":
        return launchd_state(i, service).get("state") == "running"
    unit = lifecycle_unit(i) if service == "lifecycle" else unit_name(i, service)
    return systemctl("is-active", "--quiet", unit, check=False).returncode == 0


def svc_state(i: Instance, service: str):
    if i.manager == "launchd":
        return launchd_state(i, service)
    unit = lifecycle_unit(i) if service == "lifecycle" else unit_name(i, service)
    return run(["systemctl", "show", unit, "--property=ActiveState,SubState,UnitFileState,NRestarts", "--value"], capture=True, check=False).stdout.split()


def svc_log_file(i: Instance, service: str) -> Path:
    return i.logs / f"{service}.log"


def svc_logs(i: Instance, service: str, lines: int) -> str:
    if i.manager == "launchd":
        out = run(["tail", "-n", str(lines), str(svc_log_file(i, service))], capture=True, check=False)
        return out.stdout + out.stderr
    unit = lifecycle_unit(i) if service == "lifecycle" else unit_name(i, service)
    out = run(["journalctl", "-u", unit, "-n", str(lines), "--no-pager", "-o", "short-iso"], capture=True, check=False)
    return out.stdout + out.stderr


def svc_remove(i: Instance) -> None:
    """Disable and delete this installation's services; what is left of the executor's agents is killed too."""
    if i.manager == "launchd":
        for service in service_names(i):
            state = launchd_state(i, service)
            pid = state.get("pid")
            launchctl("bootout", gui(i, service), check=False)
            if service == "executor" and pid:
                run(["pkill", "-KILL", "-g", pid], check=False, capture=True)
            plist_path(i, service).unlink(missing_ok=True)
        return
    for unit in svc_installed(i):
        systemctl("disable", "--now", unit, check=False)
        # KillMode=process leaves agents behind a stopped executor; nothing of this installation survives its removal.
        systemctl("kill", "--kill-whom=all", "--signal=SIGKILL", unit, check=False, capture=True)
        Path("/etc/systemd/system", unit).unlink()
    systemctl("daemon-reload")


def host_clock_synchronized(i: Instance) -> bool:
    if DARWIN:
        done = run(["/usr/bin/python3", str(i.installed / "runtime" / "wait-clock.py"), "--check"], capture=True, check=False)
        return done.returncode == 0
    return run(["timedatectl", "show", "--property=NTPSynchronized", "--value"], capture=True, check=False).stdout.strip() == "yes"


# ---- compose

def compose_env_path(i: Instance) -> Path:
    return i.config / "compose.env"


def write_compose_env(i: Instance) -> None:
    values = {
        "AGDEV_SLUG": i.slug,
        "AGDEV_INSTANCE_ID": i.id,
        "AGDEV_PUBLIC_HOST": i.host,
        "AGDEV_GITEA_URL": i.gitea_url,
        "AGDEV_GITEA_PORT": i.ports.get("gitea", 0),
        "AGDEV_WEB_PORT": i.ports["web"],
        "AGDEV_BIND": i.c.get("bind", "0.0.0.0"),
        "AGDEV_OWNER_EMAIL": i.owner["email"],
        "AGDEV_DATA": i.data,
        "AGDEV_TZ": i.c.get("execution", {}).get("timezone", "UTC"),
        "AGDEV_WFE_PORT": i.wfe_port,
    }
    write_private(compose_env_path(i), "".join(f"{k}={v}\n" for k, v in values.items()))


def read_env(path: Path) -> dict[str, str]:
    if not path.exists():
        return {}
    return dict(line.split("=", 1) for line in path.read_text().splitlines() if "=" in line and not line.startswith("#"))


def compose_dir(i: Instance) -> Path:
    # The Compose file and web config of the active resources; updated on activation.
    return i.config / "compose"


def compose(i: Instance, *args: str, capture=False, check=True) -> subprocess.CompletedProcess:
    cmd = ["docker", "compose", "--project-directory", str(compose_dir(i)), "-f", str(compose_dir(i) / "compose.yaml"),
           "--env-file", str(compose_env_path(i)), "--profile", "all", *args]
    env = {**os.environ, **read_env(compose_env_path(i))}
    return run(cmd, capture=capture, check=check, env=env)


def install_compose_resources(i: Instance, source: Path = HERE) -> None:
    target = compose_dir(i)
    (target / "web").mkdir(parents=True, exist_ok=True)
    shutil.copy2(source / "compose.yaml", target / "compose.yaml")
    shutil.copy2(source / "web" / "nginx.conf.template", target / "web" / "nginx.conf.template")


def install_resources(i: Instance, source: Path = HERE) -> None:
    """The installed lifecycle tool, clock gate and unit templates: a copy outside the releases,
    replaced whole. A running supervisor reloads it after its update ends (cmd_supervise)."""
    if source.resolve() == i.installed.resolve():
        return
    fresh = i.config / "install.new"
    shutil.rmtree(fresh, ignore_errors=True)
    shutil.copytree(source, fresh)
    shutil.rmtree(i.installed, ignore_errors=True)
    os.replace(fresh, i.installed)


def core_exec(i: Instance, service: str) -> tuple[str, str, str]:
    """(account, working directory, command) of a native service, on service/current."""
    current = i.area / "service" / "current"
    node = f"{i.tools['node']}/node"
    origins = f"{i.web_url},http://localhost:{i.wfe_port}"
    return {
        "wfe": (i.core_account, str(i.area), f"{node} {current}/server/main.ts --serve-dist --port {i.wfe_port} --registry {i.area}/registry.json --bind {i.c.get('bind', '0.0.0.0')} --origins {origins}"),
        "executor": (i.core_account, f"{current}/system/agautolab", f"{current}/system/agautolab/.venv/bin/python -m agautolab.wfexec"),
        "observer": (i.monitor_account, f"{current}/system/agobserver", f"{current}/system/agobserver/.venv/bin/python -m agobserver.wfmonitor"),
        "watchdog": (i.monitor_account, f"{current}/system/agobserver", f"{current}/system/agobserver/.venv/bin/python -m agobserver.watchdog"),
    }[service]


def alerts_file(i: Instance) -> Path:
    return i.state / "alerts" / "alerts.json"


def service_extra_env(i: Instance, service: str) -> dict[str, str]:
    # The alert sender is the installed tool's (outside the releases); without alerts.json there is no route.
    alerts = {"AGDEV_ALERT_TOOL": str(i.installed / "runtime" / "agdev_alert.py"), "AGDEV_ALERTS": str(alerts_file(i))}
    return {"executor": {"AGHANGOUT_CLAUDE": f"{i.tools['claude']}/claude"},
            "observer": {"AGDEV_START_DELAY": "60", "AGAG_STATUS_PATH": f"{i.state}/agobserver/agag-status.json", **alerts},
            "watchdog": {"AGDEV_START_DELAY": "60", **alerts}}.get(service, {})


def ensure_lock_dir(i: Instance) -> None:
    """WFE_LOCK_DIR of the services: under state, which is root's on Linux, so it is made here, the core
    account's and shared with the monitor through the core group (on C, p5: the first turns failed EACCES)."""
    locks = i.state / "locks"
    locks.mkdir(parents=True, exist_ok=True)
    own(locks, i.core_account, 0o2770)
    # The compile cache every `wfe` call uses (bin/wfe, lighter_services p3): Node makes a subfolder per uid,
    # so the core group must be able to write here whoever calls first.
    # Only within an area that exists: before init has made it, nothing here may create it as root.
    cache = i.area / ".local" / "node-compile-cache"
    if cache.parent.is_dir():
        cache.mkdir(exist_ok=True)
        own(cache, i.core_account, 0o2770)


def write_units(i: Instance, source: Path) -> None:
    # Every place that writes the units (init, an activation, an update's switch) also makes their lock folder.
    ensure_lock_dir(i)
    if i.manager == "launchd":
        return write_agents(i)
    write_systemd_units(i, source)


def agent_definitions(i: Instance) -> dict[str, dict]:
    """The LaunchAgents' definitions by service (written by write_agents, shown by render)."""
    out = {}
    for service in NATIVE_SERVICES:
        account, workdir, command = core_exec(i, service)
        env = {**service_env(i, account), "AGDEV_SERVICE": service, **service_extra_env(i, service)}
        agent = {"Label": label(i, service), "ProgramArguments": ["/bin/sh", str(i.installed / "runtime" / "entry.sh"), *shlex.split(command)],
                 "WorkingDirectory": workdir, "EnvironmentVariables": env, "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 10,
                 "Umask": 0o002, "StandardOutPath": str(svc_log_file(i, service)), "StandardErrorPath": str(svc_log_file(i, service)),
                 "ProcessType": "Standard"}
        if service == "executor":
            agent.update({"AbandonProcessGroup": True, "ExitTimeOut": 60})
        out[service] = agent
    return out


def systemd_units(i: Instance, source: Path) -> dict[str, str]:
    """The unit files' text by file name (written by write_systemd_units, shown by render)."""
    template = (source / "systemd" / "agdev-core.service.in").read_text()
    out = {}
    for service in NATIVE_SERVICES:
        account, workdir, command = core_exec(i, service)
        extra = "\n".join(f"Environment={k}={v}" for k, v in service_extra_env(i, service).items())
        if service == "executor":
            extra = "KillMode=process\nTimeoutStopSec=60\n" + extra
        out[unit_name(i, service)] = (template.replace("@SLUG@", i.slug).replace("@SERVICE@", service).replace("@USER@", account).replace("@WORKDIR@", workdir)
                                      .replace("@ENV@", str(i.config / f"service-{account}.env")).replace("@GATE@", str(i.installed / "runtime" / "entry.sh")).replace("@COMMAND@", command).replace("@EXTRA@", extra))
    return out


def write_agents(i: Instance) -> None:
    """The LaunchAgents of this installation: the native services on service/current through the clock gate,
    and the lifecycle service. The user's login starts them (RunAtLoad); KeepAlive restarts them."""
    agents_dir().mkdir(parents=True, exist_ok=True)
    i.logs.mkdir(parents=True, exist_ok=True)
    for service, agent in agent_definitions(i).items():
        # An executor restart leaves its agents running; the next executor adopts them (wfexec).
        write_plist(plist_path(i, service), agent)
        if not launchd_state(i, service)["loaded"]:
            # Written is not enabled: a login before the first start must not run a service without a release.
            launchctl("disable", gui(i, service), check=False)
    env = {"PATH": tool_path(i), "HOME": pwd.getpwuid(os.getuid()).pw_dir, "LANG": "en_US.UTF-8"}
    write_plist(plist_path(i, "lifecycle"), {
        "Label": label(i, "lifecycle"), "ProgramArguments": [python_bin(i), str(i.installed / "agdevctl"), "--config", str(i.config_path), "supervise"],
        "EnvironmentVariables": env, "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 10,
        # Unspecified, launchd applies light resource limits that slow the release builds it runs (p4 trial).
        "ProcessType": "Standard",
        "StandardOutPath": str(svc_log_file(i, "lifecycle")), "StandardErrorPath": str(svc_log_file(i, "lifecycle"))})
    if not launchd_state(i, "lifecycle")["loaded"]:
        launchctl("disable", gui(i, "lifecycle"), check=False)


def write_plist(path: Path, value: dict) -> None:
    tmp = path.with_name(path.name + ".tmp")
    with open(tmp, "wb") as out:
        plistlib.dump(value, out)
    os.replace(tmp, path)


def write_systemd_units(i: Instance, source: Path) -> None:
    """Generate the unit files from `source`; the units run service/current through the clock gate."""
    for name, unit in systemd_units(i, source).items():
        Path("/etc/systemd/system", name).write_text(unit)
    lifecycle = (source / "systemd" / "agdev-lifecycle@.service.in").read_text()
    lifecycle = lifecycle.replace("@SLUG@", i.slug).replace("@TOOL@", str(i.installed / "agdevctl")).replace("@CONFIG@", str(i.config_path))
    Path("/etc/systemd/system", lifecycle_unit(i)).write_text(lifecycle)
    for account in (i.core_account, i.monitor_account):
        env = service_env(i, account)
        (i.config / f"service-{account}.env").write_text("".join(f"{k}={v}\n" for k, v in env.items()))
    systemctl("daemon-reload")


# ---- init

def port_free(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            probe.bind(("0.0.0.0", port))
            return True
        except OSError:
            return False


def owned_containers(i: Instance) -> list[str]:
    out = run(["docker", "ps", "-a", "--filter", f"label=com.docker.compose.project={i.project}", "--format", "{{.Names}}"], capture=True).stdout
    return out.split()


def ensure_account(i: Instance, name: str, home: str, shell: str, groups: list[str] = ()) -> None:
    try:
        pwd.getpwnam(name)
    except KeyError:
        Path(home).parent.mkdir(parents=True, exist_ok=True)
        run(["useradd", "--system", "--user-group", "--home-dir", home, "--create-home", "--shell", shell, name])
        say(f"created account {name}")
    entry = pwd.getpwnam(name)
    Path(entry.pw_dir).mkdir(parents=True, exist_ok=True)
    own(Path(entry.pw_dir), name, 0o700)
    for group in groups:
        run(["usermod", "-aG", group, name])
    forbidden = {"docker", "sudo", "adm"} & {g.gr_name for g in grp.getgrall() if name in g.gr_mem}
    if forbidden:
        raise SystemExit(f"account {name} must not be in {sorted(forbidden)}: remove it and repeat")


def ensure_projects_root(i: Instance) -> None:
    """The project root: created under the installation's root; elsewhere (another volume) it must already exist,
    because creating a missing mount point would hide that the volume is absent."""
    root = i.projects_root
    if str(root).startswith(str(i.root) + "/"):
        root.mkdir(parents=True, exist_ok=True)
        own(root, i.core_account, 0o2770)
    elif not root.is_dir():
        raise SystemExit(f"[projects] root {root} does not exist (an unmounted volume?); create or mount it, then repeat")
    marker = root / ".agdev-projects.json"
    if not marker.exists():
        write_json(marker, {"schema": "agdev.project-root.v1", "area": str(i.area), "instance": i.id if (i.config / "instance-id").exists() else None, "prepared": now()})


def ensure_folders(i: Instance) -> None:
    """Who may touch what. WFE, the executor and agents share the area; Observer reaches it through
    the group; releases and the launcher belong to the build account, so a run cannot edit what runs;
    each service's state and every secret stay with its owner."""
    core, monitor, build = i.core_account, i.monitor_account, i.build_account
    for folder, account, mode, group in [
        (i.root, "root", 0o755, None), (i.config, "root", 0o755, None), (i.secrets, "root", 0o700, None), (i.logs, "root", 0o750, None),
        (i.bundles, "root", 0o755, None), (i.data, "root", 0o755, None), (i.sources, "root", 0o755, None),
        (i.area, core, 0o2770, None), (i.area / "service", build, 0o2755, core), (i.area / "service" / "releases", build, 0o2755, core), (i.area / "bin", build, 0o2755, core),
        (i.state, "root", 0o755, None), (i.state / "agautolab", core, 0o700, None), (i.state / "gitea", core, 0o700, None), (i.state / "system", core, 0o700, None),
        (i.state / "agobserver", monitor, 0o700, None),
        (i.lifecycle, "root", 0o2750, core), (i.lifecycle / "requests", "root", 0o2770, core), (i.lifecycle / "updates", "root", 0o2750, core),
        (i.lifecycle / "status", "root", 0o2770, core), (i.lifecycle / "backups", "root", 0o700, None),
    ]:
        folder.mkdir(parents=True, exist_ok=True)
        own(folder, account, mode, group)


def collisions(i: Instance) -> list[str]:
    """Another installation on this host that already holds a name this one would take."""
    found = []
    if i.manager == "launchd":
        for service in service_names(i):
            path = plist_path(i, service)
            if path.exists() and str(i.config_path) not in path.read_text(errors="replace") and str(i.root) not in path.read_text(errors="replace"):
                found.append(f"{path} belongs to another installation (slug {i.slug!r} is taken)")
    marker = read_json(i.projects_root / ".agdev-projects.json")
    if marker and marker.get("area") and marker["area"] != str(i.area):
        found.append(f"{i.projects_root} is the project root of the area {marker['area']}")
    return found


def cmd_init(i: Instance, args) -> None:
    clash = collisions(i)
    if clash:
        raise SystemExit("refused, nothing was changed: " + "; ".join(clash))
    run(["install", "-d", "-m", "0755", str(i.root)])
    core, monitor, build = i.core_account, i.monitor_account, i.build_account
    if unprivileged():
        # macOS: the installing user is every account; its LaunchAgents are the services (docs/install.md).
        for account in {core, monitor, build}:
            same_account(account, f"[accounts] {account}")
    else:
        ensure_account(i, core, f"{i.account_homes}/executor", "/bin/bash")
        ensure_account(i, monitor, f"{i.account_homes}/service", "/usr/sbin/nologin", [core])
        ensure_account(i, build, f"{i.account_homes}/build", "/usr/sbin/nologin", [core])
    ensure_folders(i)
    if not (i.config / "instance-id").exists():
        # Persistent for this installation's life; a move keeps it, a new experiment gets a new one.
        (i.config / "instance-id").write_text(f"{i.slug}-{secrets.token_hex(6)}\n")
        say(f"new instance id {i.id}")
    ensure_projects_root(i)
    # Commits of runs and checkpoints: no login shell or person supplies an identity here.
    gitconfig = Path(pwd.getpwnam(core).pw_dir) / ".gitconfig"
    if not gitconfig.exists():
        gitconfig.write_text(f"[user]\n\tname = agdev {i.slug}\n\temail = agent@{i.host}\n")
        own(gitconfig, core, 0o644)
    # Secrets of the dependencies this installation owns; an attached one brings its credentials ([gitea]).
    for name, owned in (("gitea_owner_password", not i.gitea_external),):
        if owned and not (i.secrets / name).exists():
            i.put_secret(name, secrets.token_urlsafe(18))
    if not owned_containers(i):
        used = {"web": i.ports["web"], "wfe": i.wfe_port, **({"gitea": i.ports["gitea"]} if not i.gitea_external else {})}
        busy = [f"{name}={port}" for name, port in used.items() if not port_free(port)]
        if busy:
            raise SystemExit(f"ports in use on this host: {', '.join(busy)}")
    install_compose_resources(i)
    install_resources(i)
    write_compose_env(i)
    write_units(i, i.installed)
    say(f"initialized {i.root} as instance {i.id}")


